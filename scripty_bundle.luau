    if customDetail then Status.detail = customDetail end

    local entry = {
        time = os.date("%X"),
        category = category or "SYSTEM",
        text = message or "",
        color = col,
    }
    table.insert(Status.logs, 1, entry)
    if #Status.logs > 60 then
        table.remove(Status.logs)
    end

    if UI.updateBanner then pcall(UI.updateBanner) end
    if UI.updateHud then pcall(UI.updateHud) end
    if UI.updateLogs then pcall(UI.updateLogs) end
    if UI.updateBlackscreen then pcall(UI.updateBlackscreen) end
end

local function recordCatch(source, count)
    count = count or 1
    FISH.catches = FISH.catches + count
    FISH.dead = 0
    castPhase = "idle"
    lastCast = 0
    lastCatchTime = os.clock()
    FISH.status = "CAUGHT ONE (" .. FISH.catches .. ")"
    logAction("FISH", ("Caught fish #%d! (+%d catch)"):format(FISH.catches, count), Color3.fromRGB(60, 240, 140), "SUCCESS",
        ("Catches: %d | Bait: %d"):format(FISH.catches, countTool("Bait")))
    if UI.updateBanner then pcall(UI.updateBanner) end
    if UI.updateHud then pcall(UI.updateHud) end
    if UI.updateBlackscreen then pcall(UI.updateBlackscreen) end
end

local function initFishWatcher()
    pcall(function()
        local _, tot = getFishCounts()
        lastKnownFishTotal = tot
        if FISH.catches < tot then FISH.catches = tot end
    end)
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        track(bp.ChildAdded:Connect(function(c)
            if c:IsA("Tool") and isFish(c) then
                if os.clock() - lastCatchTime > 0.8 then
                    recordCatch("Backpack: " .. c.Name, 1)
                end
            end
        end))
    end
    local ch = char()
    if ch then
        track(ch.ChildAdded:Connect(function(c)
            if c:IsA("Tool") and isFish(c) then
                if os.clock() - lastCatchTime > 0.8 then
                    recordCatch("Character: " .. c.Name, 1)
                end
            end
        end))
    end
end
task.spawn(initFishWatcher)
track(LP.CharacterAdded:Connect(function()
    task.wait(1)
    initFishWatcher()
end))

local function autoHitPlay()
    local pg = LP:WaitForChild("PlayerGui", 10)
    if not pg then return end
    for _ = 1, 35 do
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and (not pg:FindFirstChild("MainMenu")) then
            break
        end
        local mm = pg:FindFirstChild("MainMenu")
        if mm and mm.Enabled then
            local bc = mm:FindFirstChild("ButtonContainer")
            local btn = bc and bc:FindFirstChild("PlayButton")
            if btn and btn.Visible then
                logAction("SYSTEM", "Main Menu detected. Automatically clicking PLAY...", Color3.fromRGB(80, 220, 140))
                local clicked = false
                local gc = rawget(getfenv(), "get_connections")
                local cons = (getconnections and getconnections(btn.MouseButton1Click)) or (gc and gc(btn.MouseButton1Click))
                if cons and #cons > 0 then
                    for _, c in ipairs(cons) do
                        if c.Function then
                            pcall(c.Function)
                            clicked = true
                        end
                    end
                end
                if not clicked then
                    pcall(function()
                        local rem = RS:FindFirstChild("WesternFramework")
                            and RS.WesternFramework:FindFirstChild("Shared")
                            and RS.WesternFramework.Shared:FindFirstChild("Remotes")
                            and RS.WesternFramework.Shared.Remotes:FindFirstChild("SpawnPlayerEvent")
                        if rem and rem:IsA("RemoteEvent") then
                            rem:FireServer()
                        end
                    end)
                end
                task.wait(2)
                break
            end
        end
        task.wait(0.5)
    end
    local c = LP.Character or LP.CharacterAdded:Wait()
    pcall(function() c:WaitForChild("HumanoidRootPart", 12) end)
end
task.spawn(autoHitPlay)

-- isSellingFish and isRestockingBait declared at top

local function setSellingStatus(action, detail)
    Status.state = "SELLING"
    Status.color = Color3.fromRGB(245, 175, 60)
    if action then Status.action = action end
    if detail then
        Status.detail = detail
    else
        local _, totalFish = getFishCounts()
        Status.detail = ("Fish: %d | Moola: $%d | Vendor: Daniel"):format(totalFish, moola())
    end
    Status.stateTime = os.clock()

    if UI.updateBanner then pcall(UI.updateBanner) end
    if UI.updateHud then pcall(UI.updateHud) end
    if UI.updateBlackscreen then pcall(UI.updateBlackscreen) end
end


return {
    Status = Status,
    logAction = logAction,
    recordCatch = recordCatch,
    initFishWatcher = initFishWatcher,
    autoHitPlay = autoHitPlay,
    setSellingStatus = setSellingStatus,
}
end

-- [[[ MODULE: Config ]]]
EMBEDDED_MODULES["Config"] = function(...)
-- ============================================================
-- BRIDGER HUB (BW) - MODULE: Config
-- Config JSON persistence, Genv sync & Discord Webhooks
-- ============================================================
local ctx = ...


-- ── config persistence (without MCP) ───────────────────────────────────────
local CONFIG_FILE = "bridger_config.json"
local HttpService = game:GetService("HttpService")

local function saveConfig()
    if not writefile then
        logAction("CONFIG", "writefile not supported by executor", Color3.fromRGB(245, 90, 90), "ERROR")
        return false
    end
    local cfg = {}
    local keys = {
        "blackscreenOpaque", "fakeFlySpeed", "horseFlyKey", "silentAim", "martiniBallistics", "shootOverRocks", "chamsWhite", "aimTargetMode", "aimHitbox", "aimIgnoreFriends", "customFriends", "iHateYou", "iHateYouDistance", "martiniVantage", "onlyFireAtLowSpeeds", "maxFiringSpeed", "autoFish", "requireBait", "autoSellOutOfMoney", "lowMoneyThreshold",
        "autoQTE", "autoRestock", "baitKeep", "autoSell", "sellEvery",
        "castTimeout", "deadCastsBeforeMove", "reelDelay",
        "autoHopNearPlayer", "autoHopDistance", "autoHopIgnoreFriends",
        "autoChests", "autoHerbs", "promptRange", "autoBuy", "buyTarget", "buyReserve",
        "saintWatch", "saintGrab", "saintRetreat", "saintWindow",
        "espChest", "espHerb", "espHorse", "espPlayers", "espRange",
        "blackscreen", "showHud",
        "webhookUrl", "webhookIntervalEnabled", "webhookInterval", "webhookOnDogbane",
        "legitFishing", "visualizeLegit", "selectedSpotSlot", "activeFishingSet",
        "autoSwapSetNearPlayer", "autoSwapDistance",
        "saintPreHoldWait", "saintDefendGun", "saintGunSelect", "saintMergeTpPlayer",
    }
    S.activeFishingSet = FISH.getActiveSetName()
    S.selectedSpotSlot = FISH.getSelectedSlotIdx()
    for _, k in ipairs(keys) do
        if S[k] ~= nil then cfg[k] = S[k] end
    end
    if S.fishingSets then
        local rawSets = {}
        for setName, list in pairs(S.fishingSets) do
            if type(list) == "table" then
                rawSets[tostring(setName)] = {}
                for slotIdx = 1, 3 do
                    local pt = list[slotIdx]
                    local p = spotPos(pt)
                    local l = spotLook(pt)
                    if p then
                        if l then
                            table.insert(rawSets[tostring(setName)], { p.X, p.Y, p.Z, l.X, l.Y, l.Z })
                        else
                            table.insert(rawSets[tostring(setName)], { p.X, p.Y, p.Z })
                        end
                    end
                end
            end
        end
        cfg.savedFishingSets = rawSets
    end
    if S.stagingPoints then
        local rawStaging = {}
        for sName, pt in pairs(S.stagingPoints) do
            if typeof(pt) == "Vector3" then
                rawStaging[tostring(sName)] = { pt.X, pt.Y, pt.Z }
            end
        end
        cfg.savedStagingPoints = rawStaging
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(cfg) end)
    if ok and encoded then
        pcall(writefile, CONFIG_FILE, encoded)
        logAction("CONFIG", "Config saved to " .. CONFIG_FILE, Color3.fromRGB(80, 220, 140), "SUCCESS")
        return true
    else
        logAction("CONFIG", "Failed to encode config to JSON", Color3.fromRGB(245, 90, 90), "ERROR")
        return false
    end
end

local syncActiveFeatures

local function loadConfig()
    if not (readfile and isfile and isfile(CONFIG_FILE)) then return false end
    local ok, raw = pcall(readfile, CONFIG_FILE)
    if not ok or not raw or raw == "" then return false end
    local okDec, parsed = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okDec or type(parsed) ~= "table" then return false end
    for k, v in pairs(parsed) do
        if S[k] ~= nil and k ~= "fishingSets" and k ~= "fishingSetNames" then
            S[k] = v
        end
    end
    if parsed.savedFishingSets and type(parsed.savedFishingSets) == "table" then
        S.fishingSets = {} :: any
        for rawKey, rawList in pairs(parsed.savedFishingSets) do
            local sName = tostring(rawKey)
            if tonumber(rawKey) and parsed.fishingSetNames and type(parsed.fishingSetNames) == "table" then
                local num = tonumber(rawKey)
                local mappedName = parsed.fishingSetNames[num] or parsed.fishingSetNames[tostring(num)]
                if mappedName and mappedName ~= "" then sName = mappedName end
            end
            if type(rawList) == "table" and #rawList > 0 then
                S.fishingSets[sName] = {}
                for _, pt in ipairs(rawList) do
                    if type(pt) == "table" then
                        local pos, look
                        if #pt >= 3 then
                            pos = Vector3.new(pt[1], pt[2], pt[3])
                            if #pt >= 6 then
                                look = Vector3.new(pt[4], pt[5], pt[6])
                            end
                        elseif pt.pos then
                            pos = spotPos(pt.pos)
                            look = spotLook(pt.look)
                        end
                        if pos then
                            table.insert(S.fishingSets[sName], { pos = pos, look = look })
                        end
                    end
                end
            end
        end
    end
    if S.activeFishingSet ~= nil then
        local rawAct = tostring(S.activeFishingSet)
        if tonumber(rawAct) and parsed.fishingSetNames and type(parsed.fishingSetNames) == "table" then
            local num = tonumber(rawAct)
            local mappedName = parsed.fishingSetNames[num] or parsed.fishingSetNames[tostring(num)]
            if mappedName and mappedName ~= "" then rawAct = mappedName end
        end
        local m = rawAct:match(":%s*(.+)")
        if m and m ~= "" then rawAct = m end
        S.activeFishingSet = rawAct
    else
        S.activeFishingSet = "Default"
    end
    if S.selectedSpotSlot ~= nil then
        local n = tonumber(tostring(S.selectedSpotSlot):match("(%d+)")) or 1
        S.selectedSpotSlot = math.clamp(math.floor(n), 1, 3)
    else
        S.selectedSpotSlot = 1
    end
    if parsed.savedStagingPoints and type(parsed.savedStagingPoints) == "table" then
        S.stagingPoints = S.stagingPoints or {}
        for rawKey, pt in pairs(parsed.savedStagingPoints) do
            local sName = tostring(rawKey)
            if tonumber(rawKey) and parsed.fishingSetNames and type(parsed.fishingSetNames) == "table" then
                local num = tonumber(rawKey)
                local mappedName = parsed.fishingSetNames[num] or parsed.fishingSetNames[tostring(num)]
                if mappedName and mappedName ~= "" then sName = mappedName end
            end
            if type(pt) == "table" and #pt >= 3 then
                S.stagingPoints[sName] = Vector3.new(pt[1], pt[2], pt[3])
            end
        end
    end
    local activeName = FISH.getActiveSetName()
    S.activeFishingSet = activeName
    if S.fishingSets and S.fishingSets[activeName] then
        FISH_SPOTS = S.fishingSets[activeName]
    end
    logAction("CONFIG", "Config loaded from " .. CONFIG_FILE, Color3.fromRGB(80, 220, 140), "SUCCESS")
    if syncActiveFeatures then pcall(syncActiveFeatures) end
    return true
end

local function copyConfigAsGenv()
    local lines = { "getgenv().BW_Config = {" }
    table.insert(lines, ('    mode = %q,'):format(S.mode or "normal"))
    table.insert(lines, ("    blackscreenOpaque = %s,"):format(tostring(S.blackscreenOpaque ~= false)))
    local keys = {
        "autoFish", "requireBait", "autoSellOutOfMoney", "lowMoneyThreshold",
        "autoQTE", "autoRestock", "baitKeep", "autoSell", "sellEvery",
        "castTimeout", "deadCastsBeforeMove", "reelDelay",
        "autoHopNearPlayer", "autoHopDistance", "autoHopIgnoreFriends",
        "autoChests", "autoHerbs", "promptRange", "autoBuy", "buyTarget", "buyReserve",
        "saintWatch", "saintGrab", "saintRetreat", "saintWindow",
        "espChest", "espHerb", "espHorse", "espPlayers", "espRange",
        "blackscreen", "showHud",
        "webhookUrl", "webhookIntervalEnabled", "webhookInterval", "webhookOnDogbane",
    }
    for _, k in ipairs(keys) do
        local v = S[k]
        if v ~= nil then
            if type(v) == "string" then
                table.insert(lines, ("    %s = %q,"):format(k, v))
            elseif type(v) == "boolean" or type(v) == "number" then
                table.insert(lines, ("    %s = %s,"):format(k, tostring(v)))
            end
        end
    end
    table.insert(lines, "}")
    local str = table.concat(lines, "\n")
    if setclip then
        pcall(setclip, str)
        logAction("CONFIG", "Config copied to clipboard as getgenv().BW_Config!", Color3.fromRGB(80, 220, 140), "SUCCESS")
    else
        print(str)
        logAction("CONFIG", "Config printed to console (setclipboard unavailable)", Color3.fromRGB(245, 175, 60), "CONFIG")
    end
    return str
end

local function applyGenvConfig()
    local gcfg = getgenv().BW_Config or getgenv().BWConfig or getgenv().Config
    if type(gcfg) == "table" then
        for k, v in pairs(gcfg) do
            if S[k] ~= nil or k == "blackscreenOpaque" then
                S[k] = v
            end
        end
        logAction("CONFIG", "Configuration applied from getgenv().BW_Config", Color3.fromRGB(80, 220, 140), "SUCCESS")
        pcall(primeTeleportLoader)
        if syncActiveFeatures then pcall(syncActiveFeatures) end
    end
end

pcall(loadConfig)
pcall(applyGenvConfig)

-- ── serverhop loader priming ────────────────────────────────────────────────
primeTeleportLoader = function()
    local q = queue_on_teleport or queueonteleport or queue_on_tp or queueontp or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if not q then return false end

    local clearQ = clear_teleport_queue or clearteleportqueue or clear_tp_queue or cleartpqueue or clearqueueonteleport or (syn and syn.clear_teleport_queue)
    if clearQ then pcall(clearQ) end

    local loaderPayload = [[
        repeat task.wait(0.5) until game:IsLoaded()
        local Players = game:GetService("Players")
        local LP = Players.LocalPlayer
        while not LP do
            task.wait(0.5)
            LP = Players.LocalPlayer
        end

        task.wait(1)
        -- Attempt direct remote spawn into game
        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local wf = RS:WaitForChild("WesternFramework", 10)
            local shared = wf and wf:WaitForChild("Shared", 10)
            local remotes = shared and shared:WaitForChild("Remotes", 10)
            local spawnEv = remotes and remotes:WaitForChild("SpawnPlayerEvent", 10)
            if spawnEv then spawnEv:FireServer() end
        end)
        pcall(function()
            local pg = LP:WaitForChild("PlayerGui", 10)
            if pg then
                local mm = pg:WaitForChild("MainMenu", 8)
                if mm then
                    local bc = mm:FindFirstChild("ButtonContainer")
                    local btn = bc and bc:FindFirstChild("PlayButton")
                    if btn then
                        local cons = getconnections and getconnections(btn.MouseButton1Click)
                        if cons and #cons > 0 then
                            for _, c in ipairs(cons) do
                                if c.Function then pcall(c.Function) end
                                if c.Fire then pcall(function() c:Fire() end) end
                            end
                        end
                    end
                end
            end
        end)
        task.wait(1.5)
        local loaded = false
        for i = 1, 30 do
            if isfile and isfile("scripty.luau") and readfile and loadstring then
                local src = readfile("scripty.luau")
                if src and #src > 100 then
                    local fn, err = loadstring(src, "scripty.luau")
                    if fn then
                        task.spawn(fn)
                        loaded = true
                        break
                    end
                end
            end
            task.wait(0.5)
        end
        if not loaded and isfile and isfile("test_scripty.luau") and readfile and loadstring then
            local src = readfile("test_scripty.luau")
            if src and #src > 100 then
                local fn = loadstring(src, "test_scripty.luau")
                if fn then task.spawn(fn) end
            end
        end
    ]]

    local ok = pcall(q, loaderPayload)
    if ok then
        logAction("SYSTEM", "Teleport auto-loader primed (scripty.luau auto-spawn)", Color3.fromRGB(150, 160, 255))
    end
    return ok
end

primeTeleportLoader()
pcall(function()
    track(LP.OnTeleport:Connect(function()
        primeTeleportLoader()
    end))
end)

-- ── discord webhook system ─────────────────────────────────────────────────
local lastDogbaneCount = -1
local lastWebhookSend = 0

local function sendDiscordWebhook(title, description, fields, color)
    local url = S.webhookUrl
    if not url or url == "" or not url:find("https?://") then return false end
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then return false end

    local embed = {
        title = title or "Bridger Telemetry Update",
        description = description or "",
        color = color or 0xE6A537,
        fields = fields or {},
        footer = { text = "Bridger " .. VERSION .. " • " .. os.date("%X") },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
    }

    local payload = HttpService:JSONEncode({
        username = "Bridger Monitor",
        avatar_url = "https://i.imgur.com/8Qf9z8x.png",
        embeds = { embed },
    })

    task.spawn(function()
        pcall(function()
            req({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload,
            })
        end)
    end)
    return true
end

local function sendInventoryWebhook(reason)
    local fCounts, fTotal = getFishCounts()
    local dogbane = countDogbane()
    local curM = moola()
    local bait = countTool("Bait")
    local curRod = findTool("FishingRod") ~= nil

    local fields = {
        { name = "💰 Total Moola", value = "$" .. tostring(curM), inline = true },
        { name = "🌿 Dogbane Herbs", value = tostring(dogbane), inline = true },
        { name = "🎣 Total Fish", value = tostring(fTotal), inline = true },
        { name = "🐟 Fish Breakdown", value = string.format("Bass: %d | Snapper: %d | Cod: %d", fCounts.Bass or 0, fCounts.Snapper or 0, fCounts.Cod or 0), inline = false },
        { name = "🪱 Bait & Catches", value = string.format("Bait: %d | Catches: %d | Rod: %s", bait, FISH.catches, curRod and "Equipped" or "None"), inline = false },
        { name = "📍 Current Status", value = string.format("[%s] %s\n%s", Status.state, Status.action, Status.detail), inline = false },
    }

    local title = reason or "📊 Inventory & Status Report"
    local sent = sendDiscordWebhook(title, "Telemetry update for **" .. LP.Name .. "** (" .. (LP.DisplayName or LP.Name) .. ")", fields, 0xE6A537)
    if sent then
        lastWebhookSend = os.clock()
        logAction("WEBHOOK", "Dispatched inventory webhook to Discord", Color3.fromRGB(80, 220, 140), "WEBHOOK")
    else
        logAction("WEBHOOK", "Failed to send webhook (check URL/HTTP support)", Color3.fromRGB(245, 90, 90), "ERROR")
    end
    return sent
end


return {
    CONFIG_FILE = CONFIG_FILE,
    saveConfig = saveConfig,
    loadConfig = loadConfig,
    copyConfigAsGenv = copyConfigAsGenv,
    applyGenvConfig = applyGenvConfig,
    primeTeleportLoader = primeTeleportLoader,
    sendDiscordWebhook = sendDiscordWebhook,
    sendInventoryWebhook = sendInventoryWebhook,
    lastDogbaneCount = lastDogbaneCount,
    lastWebhookSend = lastWebhookSend,
}
end

-- [[[ MODULE: Movement ]]]
EMBEDDED_MODULES["Movement"] = function(...)
-- ============================================================
-- BRIDGER HUB (BW) - MODULE: Movement
-- Horse travel, Mounting, Safe teleport & Ghost Fake Fly
-- ============================================================
local ctx = ...


-- ── horse travel ───────────────────────────────────────────────────────────
local HORSE = { status = "idle" }
local function myHorse()
    local f = WS:FindFirstChild("Entities")
    if not f then return nil end
    for _, e in ipairs(f:GetChildren()) do
        local o = e:FindFirstChild("Owner")
        if o then
            if o:IsA("ObjectValue") and o.Value == LP then return e end
            if o.Value == LP or o.Value == LP.Name or tostring(o.Value) == tostring(LP.UserId) then return e end
        end
        local attrOwner = e:GetAttribute("Owner") or e:GetAttribute("OwnerUserId") or e:GetAttribute("OwnerName")
        if attrOwner then
            if attrOwner == LP.Name or attrOwner == LP.UserId or tostring(attrOwner) == tostring(LP.UserId) then return e end
        end
    end
    return nil
end

local function horseRoot()
    local h = myHorse()
    return h and h:FindFirstChild("HumanoidRootPart"), h
end


local function summonHorse(timeout)
    local r = root()
    local h = myHorse()
    local hp = h and h:FindFirstChild("HumanoidRootPart")
    if h and hp and r and (hp.Position - r.Position).Magnitude <= 25 then
        return h
    end

    HORSE.status = "summoning"
    logAction("HORSE", "Calling horse via whistle...", Color3.fromRGB(245, 175, 60), "TRAVEL", "Waiting for horse to appear")

    -- Call ToggleHorse remote directly to spawn horse adjacent to player
    pcall(function()
        local hc = require(game:GetService("ReplicatedStorage").Modules.HorseController)
        local uvs = debug.getupvalues(hc.Init)
        for _, uv in pairs(uvs) do
            if typeof(uv) == "table" and typeof(rawget(uv, "FireServer")) == "function" then
                uv:FireServer()
                break
            end
        end
    end)
    tap("HorseCallInput", 0.15)

    local t0 = os.clock()
    local maxWait = timeout or 8
    while os.clock() - t0 < maxWait do
        h = myHorse()
        hp = h and h:FindFirstChild("HumanoidRootPart")
        r = root()
        if h and hp and r and (hp.Position - r.Position).Magnitude <= 30 then
            logAction("HORSE", "Horse summoned: " .. h.Name, Color3.fromRGB(80, 220, 140), "TRAVEL")
            return h
        end
        task.wait(0.25)
    end
    logAction("HORSE", "Horse summon timed out", Color3.fromRGB(245, 90, 90), "ERROR")
    return myHorse()
end

local function groundY(p, ignore)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    local ex = { char() }
    if ignore then ex[#ex + 1] = ignore end
    rp.FilterDescendantsInstances = ex
    local hit = WS:Raycast(p + Vector3.new(0, 100, 0), Vector3.new(0, -3000, 0), rp)
    return hit and hit.Position.Y
end

local function isMounted(h)
    local hm = hum()
    local r = root()
    if not hm or not r then return false end

    -- 1. Standard seat
    if hm.SeatPart ~= nil then return true end

    -- 2. Character attributes (game uses IsRiding attribute)
    local c = char()
    if c and (c:GetAttribute("IsRiding") == true or c:GetAttribute("Mounted") == true or c:GetAttribute("Horse") ~= nil) then return true end
    if h and (h:GetAttribute("Rider") == LP.Name or h:GetAttribute("RiderUserId") == LP.UserId) then return true end

    -- 3. Weld / Motor6D connection between character and horse
    if c and h then
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
                if (d.Part0 and d.Part0:IsDescendantOf(h)) or (d.Part1 and d.Part1:IsDescendantOf(h)) then
                    return true
                end
            end
        end
    end

    -- 4. Sitting directly on horse saddle
    local hp = h and h:FindFirstChild("HumanoidRootPart")
    if hp and hp.Parent then
        local dist = (hp.Position - r.Position).Magnitude
        if hm.Sit and dist < 8.0 then
            return true
        end
    end

    return false
end

local function mountHorse()
    local h = myHorse()
    local hp = h and h:FindFirstChild("HumanoidRootPart")
    local r = root()

    -- If no horse or horse is farther than 25 studs, summon/recall it
    if not h or not hp or not r or (hp.Position - r.Position).Magnitude > 25 then
        h = summonHorse(8)
    end

    if not h then
        HORSE.status = "no horse"
        logAction("HORSE", "Cannot mount: horse not found", Color3.fromRGB(245, 90, 90), "ERROR")
        return false
    end

    -- Already mounted check
    if isMounted(h) then
        HORSE.status = "mounted"
        return true
    end

    hp = h:FindFirstChild("HumanoidRootPart")
    if not hp then
        HORSE.status = "horse has no root"
        logAction("HORSE", "Horse has no root part", Color3.fromRGB(245, 90, 90), "ERROR")
        return false
    end

    HORSE.status = "approaching"
    for _ = 1, 15 do
        r = root()
        if not r or not hp.Parent then break end
        local d = (hp.Position - r.Position).Magnitude
        if d <= 6 then break end
        logAction("HORSE", ("Approaching horse (%d studs)..."):format(math.floor(d)), Color3.fromRGB(245, 175, 60), "TRAVEL")
        r.CFrame = CFrame.new(r.Position + (hp.Position - r.Position).Unit * math.min(10, d - 4))
        task.wait(0.15)
    end

    task.wait(0.2)

    local prompt
    for _, d in ipairs(h:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            prompt = d
            break
        end
    end

    logAction("HORSE", "Activating Mount prompt...", Color3.fromRGB(245, 175, 60), "TRAVEL")
    if prompt and firepp then
        pcall(firepp, prompt, 0)
    end

    local tMount = os.clock()
    while os.clock() - tMount < 3.0 do
        task.wait(0.15)
        if isMounted(h) then
            HORSE.status = "mounted"
            logAction("HORSE", "Mounted horse successfully", Color3.fromRGB(80, 220, 140), "TRAVEL")
            return true
        end
        if prompt and firepp then
            pcall(firepp, prompt, 0)
        end
    end

    local ok = isMounted(h)
    HORSE.status = ok and "mounted" or "mount failed"
    if ok then
        logAction("HORSE", "Mounted horse successfully", Color3.fromRGB(80, 220, 140), "TRAVEL")
    else
        logAction("HORSE", "Horse mount failed", Color3.fromRGB(245, 90, 90), "ERROR")
    end
    return ok
end

-- DIRECT TELEPORT PROHIBITED: ALL TRAVEL REQUIRES GENUINELY MOUNTED HORSE
local function horseTeleport(dest)
    dest = spotPos(dest)
    if not dest then return false end
    if typeof(dest) == "CFrame" then dest = dest.Position end
    local r = root()
    if not r then return false end
    if (r.Position - dest).Magnitude < 15 then
        HORSE.status = "already there"
        return true
    end
    local distInitial = math.floor((r.Position - dest).Magnitude)
    local stKey = (isSellingFish and "SELLING") or (isRestockingBait and "RESTOCK") or "TRAVEL"
    local col = (stKey == "SELLING" or stKey == "RESTOCK") and Color3.fromRGB(245, 175, 60) or Color3.fromRGB(90, 180, 255)
    local actPrefix = isSellingFish and "Traveling to Daniel to sell fish..." or (isRestockingBait and "Traveling to Daniel for bait..." or ("Initiating travel (%d studs away)..."):format(distInitial))

    logAction(stKey, actPrefix, col, stKey, ("Distance: %d studs"):format(distInitial))

    local mounted = false
    local hp, hObj
    for attempt = 1, 3 do
        mounted = mountHorse()
        hp, hObj = horseRoot()
        if mounted and hp and hp.Parent and isMounted(hObj) then
            break
        end
        task.wait(0.5)
    end

    -- STRICT SAFETY: If not genuinely mounted on the horse, NEVER teleport!
    if not mounted or not hp or not hp.Parent or not isMounted(hObj) then
        logAction(stKey, "Cannot travel: horse not mounted (direct teleport disabled)", Color3.fromRGB(245, 90, 90), "ERROR")
        return false
    end

    HORSE.status = "travelling"
    local t = dest
    local rpTele = RaycastParams.new()
    rpTele.FilterType = Enum.RaycastFilterType.Exclude
    rpTele.IgnoreWater = false
    local ex = { char() }
    if hObj then table.insert(ex, hObj) end
    rpTele.FilterDescendantsInstances = ex
    local hit = WS:Raycast(dest + Vector3.new(0, 8, 0), Vector3.new(0, -25, 0), rpTele)
    if hit and hit.Material ~= Enum.Material.Water then
        t = Vector3.new(dest.X, hit.Position.Y + 3.0, dest.Z)
    else
        local g = groundY(dest, hObj)
        if g and math.abs(g - dest.Y) < 20 then
            t = Vector3.new(dest.X, g + 3.0, dest.Z)
        end
    end

    for _ = 1, 15 do
        local rr = root()
        if hp and hp.Parent then hp.CFrame = CFrame.new(t); hp.AssemblyLinearVelocity = Vector3.zero end
        if rr then rr.CFrame = CFrame.new(t + Vector3.new(0, 2.0, 0)); rr.AssemblyLinearVelocity = Vector3.zero end
        RunService.Heartbeat:Wait()
    end
    task.wait(0.5)
    local rr = root()
    local offset = rr and math.floor((rr.Position - dest).Magnitude) or 999
    if rr and offset < 45 then
        local arrMsg = isSellingFish and "Arrived at Daniel (Fish Buyer)" or (isRestockingBait and "Arrived at Daniel (Bait Vendor)" or ("Arrived at destination (%d studs off)"):format(offset))
        logAction(stKey, arrMsg, Color3.fromRGB(80, 220, 140), stKey)
        return true
    end

    logAction(stKey, "Horse travel failed to reach destination", Color3.fromRGB(245, 90, 90), "ERROR")
    return false
end

local function dismount()
    local stKey = (isSellingFish and "SELLING") or (isRestockingBait and "RESTOCK") or "HORSE"
    logAction(stKey, "Dismounting horse...", Color3.fromRGB(160, 165, 180), stKey)
    local hm = hum()
    local hObj = myHorse()
    local c = char()
    local r = root()
    for _ = 1, 6 do
        if not isMounted(hObj) and not (hm and hm.Sit) then break end
        tap("HorseDismountInput", 0.15)
        tap("ActionInput2", 0.15)
        pcall(function()
            if keyclickFn then
                keyclickFn(0x20)
                task.wait(0.04)
                keyclickFn(0x45)
            elseif keypressFn and keyreleaseFn then
                keypressFn(0x20)
                task.wait(0.04)
                keyreleaseFn(0x20)
                keypressFn(0x45)
                task.wait(0.04)
                keyreleaseFn(0x45)
            end
        end)
        if hObj and firepp then
            for _, d in ipairs(hObj:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled then
                    pcall(firepp, d, 0)
                end
            end
        end
        if c and hObj then
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
                    if (d.Part0 and d.Part0:IsDescendantOf(hObj)) or (d.Part1 and d.Part1:IsDescendantOf(hObj)) then
                        pcall(function() d:Destroy() end)
                    end
                end
            end
            for _, d in ipairs(hObj:GetDescendants()) do
                if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
                    if (d.Part0 and d.Part0:IsDescendantOf(c)) or (d.Part1 and d.Part1:IsDescendantOf(c)) then
                        pcall(function() d:Destroy() end)
                    end
                end
            end
        end
        if hm then
            if hm.SeatPart then
                for _, ch in ipairs(hm.SeatPart:GetChildren()) do
                    if ch:IsA("Weld") or ch:IsA("WeldConstraint") or ch.Name == "SeatWeld" then
                        pcall(function() ch:Destroy() end)
                    end
                end
            end
            hm.Sit = false
            pcall(function() hm:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            pcall(function() hm:ChangeState(Enum.HumanoidStateType.Jumping) end)
            hm.Jump = true
        end
        if r then
            pcall(function() r.CFrame = r.CFrame + Vector3.new(0, 3, 0) end)
        end
        task.wait(0.25)
    end
    task.wait(0.2)
end

local function landBeside(pos, offset)
    dismount()
    task.wait(0.3)
    local r = root()
    if not r then return false end
    pos = spotPos(pos) or pos
    offset = offset or 5
    local best
    for _, dir in ipairs({ Vector3.new(1,0,0), Vector3.new(-1,0,0), Vector3.new(0,0,1), Vector3.new(0,0,-1),
                           Vector3.new(1,0,1).Unit, Vector3.new(-1,0,-1).Unit }) do
        local cand = pos + dir * offset
        local g = groundY(cand)
        if g and math.abs(g - pos.Y) < 12 then best = Vector3.new(cand.X, g + 3.5, cand.Z); break end
    end
    if not best then
        local g = groundY(pos) or pos.Y
        best = Vector3.new(pos.X, g + 3.5, pos.Z)
    end
    for _ = 1, 10 do
        local rr = root()
        if rr then rr.CFrame = CFrame.new(best); rr.AssemblyLinearVelocity = Vector3.zero end
        RunService.Heartbeat:Wait()
    end
    task.wait(0.4)
    local stKey = (isSellingFish and "SELLING") or (isRestockingBait and "RESTOCK") or "TRAVEL"
    local landMsg = isSellingFish and "Arrived at Daniel for selling" or (isRestockingBait and "Arrived at Daniel for restock" or "Arrived at destination")
    logAction(stKey, landMsg, Color3.fromRGB(160, 165, 180), stKey)
    return true
end

-- ── Fake Horse Fly (Client-Side Desync / Ghost Flight) ─────────────────────
local fakeFly = {
    active = false,
    ghostModel = nil,
    landingCircle = nil,
    savedTransparency = {},
    conn = nil,
    inputConn = nil,
    inputBeganConn = nil,
    inputEndedConn = nil,
}

local function getPlayerControls()
    local ps = LP:FindFirstChild("PlayerScripts")
    local pm = ps and ps:FindFirstChild("PlayerModule")
    if pm then
        local ok, mod = pcall(require, pm)
        if ok and mod and mod.GetControls then
            return mod:GetControls()
        end
    end
    return nil
end

local function cleanupFakeFlyVisuals()
    if fakeFly.conn then
        pcall(function() fakeFly.conn:Disconnect() end)
        fakeFly.conn = nil
    end

    if fakeFly.inputConn then
        pcall(function() fakeFly.inputConn:Disconnect() end)
        fakeFly.inputConn = nil
    end

    if fakeFly.inputBeganConn then
        pcall(function() fakeFly.inputBeganConn:Disconnect() end)
        fakeFly.inputBeganConn = nil
    end

    if fakeFly.inputEndedConn then
        pcall(function() fakeFly.inputEndedConn:Disconnect() end)
        fakeFly.inputEndedConn = nil
    end

    pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.Default end)

    if fakeFly.landingCircle then
        pcall(function() fakeFly.landingCircle:Destroy() end)
        fakeFly.landingCircle = nil
    end

    if fakeFly.ghostModel then
        pcall(function() fakeFly.ghostModel:Destroy() end)
        fakeFly.ghostModel = nil
    end

    for part, trans in pairs(fakeFly.savedTransparency) do
        if part and part.Parent then
            pcall(function() part.Transparency = trans end)
        end
    end
    table.clear(fakeFly.savedTransparency)

    -- Re-enable player movement controls
    local ctrl = getPlayerControls()
    if ctrl then pcall(function() ctrl:Enable() end) end

    -- Reset camera back to player
    local hm = hum()
    local cam = WS.CurrentCamera
    if cam then
        pcall(function()
            cam.CameraType = Enum.CameraType.Custom
            if hm then cam.CameraSubject = hm end
        end)
    end
end

local function stopFakeHorseFly(teleportToFloor)
    if not fakeFly.active then return end
    fakeFly.active = false
    S.fakeHorseFly = false

    local landingPos = nil
    if fakeFly.ghostModel and fakeFly.ghostModel.PrimaryPart then
        landingPos = fakeFly.ghostModel.PrimaryPart.Position
    end

    cleanupFakeFlyVisuals()

    if teleportToFloor and landingPos then
        local floorY = groundY(landingPos, char())
        if floorY then
            local dest = Vector3.new(landingPos.X, floorY, landingPos.Z)
            logAction("TRAVEL", ("Landing from Horsefly: Traveling horse & body to floor (%.0f, %.0f, %.0f)..."):format(dest.X, dest.Y, dest.Z), Color3.fromRGB(80, 220, 140), "TRAVEL")
            task.spawn(function()
                horseTeleport(dest)
            end)
        else
            logAction("TRAVEL", "Horsefly landing cancelled: No ground below to land on", Color3.fromRGB(245, 175, 60), "TRAVEL")
        end
    else
        logAction("TRAVEL", "Horsefly ended", Color3.fromRGB(160, 165, 180), "IDLE")
    end

    if UI.updateToggles then pcall(UI.updateToggles) end
end

local function startFakeHorseFly()
    if fakeFly.active then return end

    local c = char()
    local r = root()
    local hm = hum()
    local h = myHorse()
    if not c or not r or not hm then
        logAction("TRAVEL", "Character not ready for Fake Horse Fly", Color3.fromRGB(245, 90, 90), "ERROR")
        S.fakeHorseFly = false
        return
    end

    if not h or not isMounted(h) then
        logAction("TRAVEL", "Mounting horse before initiating Fake Horse Fly...", Color3.fromRGB(245, 175, 60), "TRAVEL")
        if not mountHorse() then
            logAction("TRAVEL", "Cannot Fake Fly: must be mounted on your horse", Color3.fromRGB(245, 90, 90), "ERROR")
            S.fakeHorseFly = false
            return
        end
        h = myHorse()
    end

    local hp = h and h:FindFirstChild("HumanoidRootPart")
    if not hp then
        logAction("TRAVEL", "Horse has no root part", Color3.fromRGB(245, 90, 90), "ERROR")
        S.fakeHorseFly = false
        return
    end

    fakeFly.active = true
    logAction("TRAVEL", "Horsefly ACTIVE! (RMB drag to look, WASD to fly, Space=Up, Shift=Down)", Color3.fromRGB(80, 220, 140), "TRAVEL")

    -- 1. Onion Skin on Real Body & Real Horse
    table.clear(fakeFly.savedTransparency)
    for _, inst in ipairs({ c, h }) do
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") or d:IsA("Decal") then
                fakeFly.savedTransparency[d] = d.Transparency
                d.Transparency = math.max(0.65, d.Transparency)
            end
        end
    end

    -- Disable standard WASD movement controls so real body/horse remain in natural stationary idle
    local ctrl = getPlayerControls()
    if ctrl then pcall(function() ctrl:Disable() end) end

    -- 2. Build Flying Visual Ghost Model
    local ghostModel = Instance.new("Model")
    ghostModel.Name = "GhostHorseFlight"

    local ghostRoot = Instance.new("Part")
    ghostRoot.Name = "GhostRoot"
    ghostRoot.Size = Vector3.new(2, 2, 2)
    ghostRoot.Transparency = 1
    ghostRoot.CanCollide = false
    ghostRoot.CanTouch = false
    ghostRoot.CanQuery = false
    ghostRoot.Anchored = true
    ghostRoot.CFrame = hp.CFrame
    ghostRoot.Parent = ghostModel
    ghostModel.PrimaryPart = ghostRoot

    c.Archivable = true
    local cClone = c:Clone()
    cClone.Name = "VisualRider"
    for _, d in ipairs(cClone:GetDescendants()) do
        if d:IsA("BasePart") then
            d.CanCollide = false
            d.CanTouch = false
            d.CanQuery = false
            d.Anchored = true
            d.CastShadow = false
            local nl = d.Name:lower()
            if d.Name == "HumanoidRootPart" or nl:find("root") or nl:find("collision") or nl:find("hitbox") then
                d.Transparency = 1
            else
                d.Transparency = 0
            end
        elseif d:IsA("Decal") then
            d.Transparency = 0
        elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
            d:Destroy()
        end
    end
    cClone.Parent = ghostModel

    h.Archivable = true
    local hClone = h:Clone()
    hClone.Name = "VisualHorse"
    for _, d in ipairs(hClone:GetDescendants()) do
        if d:IsA("BasePart") then
            d.CanCollide = false
            d.CanTouch = false
            d.CanQuery = false
            d.Anchored = true
            d.CastShadow = false
            local nl = d.Name:lower()
            if d.Name == "HumanoidRootPart" or nl:find("root") or nl:find("collision") or nl:find("hitbox") then
                d.Transparency = 1
            else
                d.Transparency = 0
            end
        elseif d:IsA("Decal") then
            d.Transparency = 0
        elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
            d:Destroy()
        end
    end
    hClone.Parent = ghostModel

    local cam = WS.CurrentCamera
    ghostModel.Parent = cam or WS
    fakeFly.ghostModel = ghostModel

    -- Ground landing indicator (green circle on the ground directly below)
    local landingCircle = Instance.new("Part")
    landingCircle.Name = "HorseflyLandingCircle"
    landingCircle.Shape = Enum.PartType.Cylinder
    landingCircle.Size = Vector3.new(0.08, 6.5, 6.5)
    landingCircle.Color = Color3.fromRGB(50, 255, 120)
    landingCircle.Material = Enum.Material.Neon
    landingCircle.Transparency = 1
    landingCircle.CanCollide = false
    landingCircle.CanTouch = false
    landingCircle.CanQuery = false
    landingCircle.CastShadow = false
    landingCircle.Anchored = true
    landingCircle.Parent = cam or WS
    fakeFly.landingCircle = landingCircle

    local circleParams = RaycastParams.new()
    circleParams.FilterType = Enum.RaycastFilterType.Exclude
    circleParams.FilterDescendantsInstances = { c, h, ghostModel, landingCircle, cam or WS.CurrentCamera }
    circleParams.IgnoreWater = false

    -- Initialize camera angles from existing camera direction
    local curCF = hp.CFrame
    local yaw = 0
    local pitch = 0
    local camDist = 14

    if cam then
        local rx, ry, _ = cam.CFrame:ToEulerAnglesYXZ()
        yaw = ry
        pitch = math.clamp(rx, -1.2, 1.2)
        cam.CameraType = Enum.CameraType.Scriptable
    end

    -- 3. Mouse Movement Listeners (Hold Right-Click to orbit / pan camera smoothly)
    fakeFly.inputBeganConn = UIS.InputBegan:Connect(function(input, gpe)
        if not fakeFly.active then return end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition end)
        end
    end)

    fakeFly.inputEndedConn = UIS.InputEnded:Connect(function(input, gpe)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.Default end)
        end
    end)

    fakeFly.inputConn = UIS.InputChanged:Connect(function(input, gpe)
        if not fakeFly.active then return end
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            camDist = math.clamp(camDist - input.Position.Z * 2.5, 4, 40)
        elseif input.UserInputType == Enum.UserInputType.MouseMovement then
            if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
                local sens = 0.0035
                yaw = yaw - input.Delta.X * sens
                pitch = math.clamp(pitch - input.Delta.Y * sens, -1.35, 1.35)
            end
        end
    end)

    -- 4. Flight & Camera Update Loop
    fakeFly.conn = RunService.RenderStepped:Connect(function(dt)
        if not fakeFly.active or not S.fakeHorseFly then
            cleanupFakeFlyVisuals()
            return
        end

        local cNow = char()
        local hmNow = hum()
        if not cNow or not hmNow or hmNow.Health <= 0 then
            stopFakeHorseFly(false)
            return
        end

        local curCam = WS.CurrentCamera
        if not curCam then return end

        -- Orbit camera behind the ghost horse based on yaw and pitch
        local rotCF = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
        local camOffset = rotCF:PointToWorldSpace(Vector3.new(0, 3, camDist))
        local camCF = CFrame.lookAt(curCF.Position + camOffset, curCF.Position + Vector3.new(0, 2, 0))
        curCam.CFrame = camCF

        -- Fly in the direction the camera is facing
        local moveDir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCF.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCF.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCF.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCF.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.yAxis end

        local speed = S.fakeFlySpeed or 75
        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
            curCF = curCF + moveDir * (speed * dt)

            -- Turn ghost horse to face flight direction
            local flatDir = Vector3.new(moveDir.X, 0, moveDir.Z)
            if flatDir.Magnitude > 0.05 then
                curCF = CFrame.new(curCF.Position, curCF.Position + flatDir.Unit)
            end
        end

        if fakeFly.ghostModel and fakeFly.ghostModel.PrimaryPart then
            fakeFly.ghostModel:PivotTo(curCF)
        end

        -- Update ground landing indicator circle
        if fakeFly.landingCircle then
            local rayResult = WS:Raycast(curCF.Position, Vector3.new(0, -3000, 0), circleParams)
            if rayResult then
                local norm = rayResult.Normal
                local ref = math.abs(norm.Y) > 0.9 and Vector3.xAxis or Vector3.yAxis
                local right = norm:Cross(ref).Unit
                local forward = norm:Cross(right).Unit
                fakeFly.landingCircle.CFrame = CFrame.fromMatrix(rayResult.Position + norm * 0.06, norm, right, forward)
                fakeFly.landingCircle.Transparency = 0.45
            else
                fakeFly.landingCircle.Transparency = 1
            end
        end
    end)
end

-- Exact coordinates for Mud Witch / Tonic Brewing Hut
local TONIC_STATION_POS = Vector3.new(-2410.98, 42.79, -5214.38)
local function findTonicStation()
    for _, container in ipairs({ WS:FindFirstChild("Map"), WS:FindFirstChild("Entities"), WS }) do
        if container then
            for _, c in ipairs(container:GetChildren()) do
                local n = c.Name:lower()
                if n:find("tonic") or n:find("brew") or n:find("kettle") or n:find("witch") then
                    local p = c:IsA("BasePart") and c.Position or (c:FindFirstChildWhichIsA("BasePart") and c:FindFirstChildWhichIsA("BasePart").Position)
                    if p then return p, c end
                end
            end
        end
    end
    return TONIC_STATION_POS, nil
end


return {
    HORSE = HORSE,
    myHorse = myHorse,
    horseRoot = horseRoot,
    summonHorse = summonHorse,
    groundY = groundY,
    isMounted = isMounted,
    mountHorse = mountHorse,
    horseTeleport = horseTeleport,
    dismount = dismount,
    landBeside = landBeside,
    getPlayerControls = getPlayerControls,
    cleanupFakeFlyVisuals = cleanupFakeFlyVisuals,
    stopFakeHorseFly = stopFakeHorseFly,
    startFakeHorseFly = startFakeHorseFly,
    findTonicStation = findTonicStation,
    fakeFly = fakeFly,
}
end

-- [[[ MODULE: Safety ]]]
EMBEDDED_MODULES["Safety"] = function(...)
-- ============================================================
-- BRIDGER HUB (BW) - MODULE: Safety
-- Friends list cache, Player proximity check & Server Hopper
-- ============================================================
local ctx = ...


-- ── safety & server hopping ────────────────────────────────────────────────
local hoppingServer = false
local function serverHop()
    if hoppingServer then return end
    hoppingServer = true

    logAction("SAFETY", "Initiating Server Hop...", Color3.fromRGB(255, 120, 60), "HOP")
    Status.state = "HOP"
    Status.action = "Finding new server..."
    Status.detail = "Querying Roblox public servers"
    Status.color = Color3.fromRGB(255, 120, 60)
    if UI.updateBanner then pcall(UI.updateBanner) end
    if UI.updateBlackscreen then pcall(UI.updateBlackscreen) end

    primeTeleportLoader()

    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local placeId = game.PlaceId
    local currentJob = game.JobId

    local req = (syn and syn.request) or (http and http.request) or http_request or request
    local candidateServers = {}
    local cursor = ""

    for _ = 1, 3 do
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
        local raw
        pcall(function()
            if req then
                local res = req({ Url = url, Method = "GET" })
                raw = res and res.Body
            elseif game.HttpGet then
                raw = game:HttpGet(url)
            end
        end)

        if raw then
            local ok, parsed = pcall(function() return HttpService:JSONDecode(raw) end)
            if ok and parsed and parsed.data then
                for _, s in ipairs(parsed.data) do
                    local playing = s.playing or 0
                    local maxP = s.maxPlayers or 20
                    if s.id ~= currentJob and playing > 0 and playing < maxP then
                        candidateServers[#candidateServers + 1] = s
                    end
                end
                if #candidateServers > 0 then break end
                if parsed.nextPageCursor then
                    cursor = parsed.nextPageCursor
                else
                    break
                end
            end
        end
        task.wait(0.4)
    end

    if #candidateServers > 0 then
        local chosen = candidateServers[math.random(1, #candidateServers)]
        local shortId = tostring(chosen.id):sub(1, 8)
        logAction("SAFETY", ("Hopping to server %s (%d/%d players)..."):format(shortId, chosen.playing or 0, chosen.maxPlayers or 20), Color3.fromRGB(80, 220, 140), "HOP")
        Status.detail = ("Joining %s (%d/%d)"):format(shortId, chosen.playing or 0, chosen.maxPlayers or 20)
        if UI.updateBanner then pcall(UI.updateBanner) end
        if UI.updateBlackscreen then pcall(UI.updateBlackscreen) end

        primeTeleportLoader()
        pcall(saveConfig)
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, chosen.id, LP)
        end)
        if not ok then
            logAction("SAFETY", "Instance teleport failed, using fallback Teleport: " .. tostring(err), Color3.fromRGB(255, 100, 100), "HOP")
            primeTeleportLoader()
            pcall(saveConfig)
            TeleportService:Teleport(placeId, LP)
        end
    else
        logAction("SAFETY", "No candidate server found in list, using fallback Teleport...", Color3.fromRGB(245, 160, 60), "HOP")
        primeTeleportLoader()
        pcall(saveConfig)
        TeleportService:Teleport(placeId, LP)
    end
end

-- Robust friends management: Official Roblox friends + custom whitelist
local myFriends = {}
local friendsLoaded = false

local function loadFriendsList()
    task.spawn(function()
        local lp = LP or Players.LocalPlayer
        if not lp or not lp.UserId or lp.UserId <= 0 then
            task.wait(1)
            lp = LP or Players.LocalPlayer
        end
        if not lp or not lp.UserId or lp.UserId <= 0 then return end

        local loadedCount = 0
        -- Method 1: Official engine API (fast, reliable, returns usernames)
        local ok, pages = pcall(function() return Players:GetFriendsAsync(lp.UserId) end)
        if ok and pages then
            while true do
                for _, item in ipairs(pages:GetCurrentPage()) do
                    if item.Id then myFriends[item.Id] = true end
                    if item.Username and item.Username ~= "" then
                        myFriends[item.Username:lower()] = true
                        loadedCount = loadedCount + 1
                    end
                end
                if pages.IsFinished then break end
                local aOk = pcall(function() pages:AdvanceToNextPageAsync() end)
                if not aOk then break end
            end
        end

        -- Method 2: Fallback to web API if method 1 returned 0
        if loadedCount == 0 then
            local req = (syn and syn.request) or (http and http.request) or http_request or request
            if req then
                local url = "https://friends.roblox.com/v1/users/" .. tostring(lp.UserId) .. "/friends"
                local rOk, res = pcall(function() return req({ Url = url, Method = "GET" }) end)
                if rOk and res and res.Body then
                    local pOk, data = pcall(function() return game:GetService("HttpService"):JSONDecode(res.Body) end)
                    if pOk and data and data.data then
                        for _, f in ipairs(data.data) do
                            if f.id then myFriends[f.id] = true end
                            if f.name and f.name ~= "" then
                                myFriends[f.name:lower()] = true
                                loadedCount = loadedCount + 1
                            end
                        end
                    end
                end
            end
        end

        friendsLoaded = true
        if UI and UI.friendsCountLabel then
            UI.friendsCountLabel:Set(string.format("%d friends loaded", loadedCount))
        end
        logAction("FRIENDS", string.format("Friends list cached (%d friends loaded)", loadedCount), Color3.fromRGB(80, 220, 140), "FRIENDS")
    end)
end
loadFriendsList()

local function isPlayerFriend(p)
    if not p then return false end

    local name, uid
    if typeof(p) == "string" then
        name = p
        local pl = Players:FindFirstChild(p)
        if pl then uid = pl.UserId end
    elseif typeof(p) == "Instance" then
        if p:IsA("Player") then
            name = p.Name
            uid = p.UserId
        else
            local pl = Players:GetPlayerFromCharacter(p)
            if pl then
                name = pl.Name
                uid = pl.UserId
            else
                name = p.Name
            end
        end
    end

    local lowerName = name and name:lower()

    -- 1. Check custom whitelist from settings
    if S.customFriends and S.customFriends ~= "" and lowerName then
        for rawName in string.gmatch(S.customFriends, "[^,%s]+") do
            if rawName:lower() == lowerName then
                return true
            end
        end
    end

    -- 2. Check cached friends table
    if uid and myFriends[uid] ~= nil then
        return myFriends[uid]
    end
    if lowerName and myFriends[lowerName] ~= nil then
        return myFriends[lowerName]
    end

    -- 3. If not cached, initiate non-blocking background check
    if uid and uid > 0 and LP and LP.UserId and LP.UserId > 0 then
        myFriends[uid] = false
        if lowerName then myFriends[lowerName] = false end

        task.spawn(function()
            local ok, isF = pcall(function() return LP:IsFriendsWith(uid) end)
            if ok and isF == true then
                myFriends[uid] = true
                if lowerName then myFriends[lowerName] = true end
            end
        end)
    end

    return false
end

local function playerProximityTick()
    if (not S.autoHopNearPlayer and not S.autoSwapSetNearPlayer) or hoppingServer then return end
    local myRoot = root()
    local myPos = myRoot and myRoot.Position
    if not myPos then
        local hr = select(1, horseRoot())
        myPos = hr and hr.Position
    end
    if not myPos then return end
    local hopThreshold = S.autoHopDistance or 200
    local swapThreshold = S.autoSwapDistance or 150

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local skip = false
            if S.autoHopIgnoreFriends and isPlayerFriend(p) then
                skip = true
            end

            if not skip then
                local c = p.Character
                local pRoot = c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Head"))
                local h = c and c:FindFirstChildOfClass("Humanoid")
                local isAlive = not h or h.Health > 0

                if pRoot and isAlive then
                    local dist = (pRoot.Position - myPos).Magnitude
                    local name = p.DisplayName and p.DisplayName ~= "" and p.DisplayName or p.Name

                    -- Proximity set swapping (alternative to server hop)
                    -- Explicit requirement: disabled when legit is on!
                    if S.autoSwapSetNearPlayer and not S.legitFishing and dist <= swapThreshold then
                        if not S._lastSwapNearPlayer or os.clock() - S._lastSwapNearPlayer > 12 then
                            S._lastSwapNearPlayer = os.clock()
                            local setList = FISH.getSetNames()
                            if #setList > 1 then
                                local curName = FISH.getActiveSetName()
                                local curIdx = table.find(setList, curName) or 1
                                local nextIdx = (curIdx % #setList) + 1
                                local nextName = setList[nextIdx]
                                logAction("SAFETY", string.format("Player '%s' (@%s) entered proximity (%.0f / %d studs)! Swapping to Fishing Set '%s' instead of hopping.",
                                    name, p.Name, dist, swapThreshold, nextName), Color3.fromRGB(255, 140, 60), "SAFETY")
                                FISH.setActiveSet(nextName)
                                return
                            end
                        end
                    end

                    -- Auto server hop
                    if S.autoHopNearPlayer and dist <= hopThreshold then
                        local pStand, pTier, pAlign = getStandInfo(p)
                        logAction("SAFETY", ("Player '%s' (@%s, Stand: %s [%s]) entered proximity (%.0f / %d studs)! Hopping server immediately!"):format(
                            name, p.Name, pStand, pAlign, dist, hopThreshold), Color3.fromRGB(255, 70, 70), "HOP")
                        task.spawn(serverHop)
                        return
                    end
                end
            end
        end
    end
end


return {
    serverHop = serverHop,
    loadFriendsList = loadFriendsList,
    isPlayerFriend = isPlayerFriend,
    playerProximityTick = playerProximityTick,
}
end

