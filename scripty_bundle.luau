-- lastCast, castPhase, tappedThisCast forward declared at top
tappedThisCast = false
local biteFlag = false

-- biteWatchStarted declared at top
local function startBiteWatch()
    if biteWatchStarted then return end
    biteWatchStarted = true
    task.spawn(function()
        while S.running do
            if S.autoFish and castPhase == "casted" and not tappedThisCast
               and os.clock() - lastCast > 1.5 then
                local r = root()
                local c = char()
                if r then
                    local detected = false
                    if c then
                        for _, sfx in ipairs(c:GetDescendants()) do
                            if sfx:IsA("Sound") and sfx.IsPlaying then
                                local sn = sfx.Name:lower()
                                if sn:find("bite") or sn:find("splash") or sn:find("reel") or sn == "fishbite" or sn == "bitecrunch" then
                                    detected = true
                                    break
                                end
                            end
                        end
                    end
                    if not detected then
                        local op = OverlapParams.new()
                        op.MaxParts = 25
                        local nearby = WS:GetPartBoundsInRadius(r.Position, 75, op)
                        for _, d in ipairs(nearby) do
                            for _, sfx in ipairs(d:GetChildren()) do
                                if sfx:IsA("Sound") and sfx.IsPlaying then
                                    local sn = sfx.Name:lower()
                                    if sn:find("bite") or sn:find("splash") or sn:find("reel") or sn == "fishbite" or sn == "bitecrunch" then
                                        detected = true
                                        break
                                    end
                                end
                            end
                            if detected then break end
                        end
                    end

                    if detected then
                        tappedThisCast = true
                        _lastReelTap = os.clock()
                        task.wait(S.reelDelay or 0.25)
                        if IH then
                            pcall(function() IH:FireVirtualInput("PrimaryInput", true) end)
                            pcall(function() IH:FireVirtualInput("PrimaryInput", false) end)
                        end
                        FISH.status = "BITE - reeling"
                        logAction("BITE", "Fish bite sound detected! Striking & reeling...", Color3.fromRGB(255, 175, 50), "BITE")
                        task.spawn(function()
                            local t1 = os.clock()
                            while os.clock() - t1 < 8 and S.running do
                                if LP:GetAttribute("IsMashing") == true
                                   or LP:GetAttribute("IsShaking") == true then break end
                                local playing = false
                                local hh = hum()
                                local an = hh and hh:FindFirstChildOfClass("Animator")
                                if an then
                                    for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                                        local id = tostring(tr.Animation and tr.Animation.AnimationId):match("(%d+)")
                                        if id == "85381268135994" then playing = true; break end
                                    end
                                end
                                if not playing then break end
                                if IH then
                                    pcall(function() IH:FireVirtualInput("PrimaryInput", true) end)
                                    task.wait(0.03)
                                    pcall(function() IH:FireVirtualInput("PrimaryInput", false) end)
                                end
                                task.wait(0.16 + math.random() * 0.06)
                            end
                        end)
                    end
                end
            end
            task.wait(0.08)
        end
    end
    biteWatchStarted = false
end)
end


local function fishTick()
    if not S.running or not S.autoFish then return end
    local r = root()
    if not r or not r.Parent then return end
    if isSellingFish or isRestockingBait then return end

    if handleQTE() then
        local t0 = os.clock()
        while os.clock() - t0 < 12 and S.running and S.autoFish do
            if not handleQTE() then break end
            task.wait(0.03)
        end
        return
    end
    if biteFlag then
        biteFlag = false
        if castPhase == "casted" and not tappedThisCast then
            tappedThisCast = true
            _lastReelTap = os.clock()
            tap("PrimaryInput")
            FISH.status = "BITE - reeling"
            logAction("BITE", "Bite detected! Auto-reeling...", Color3.fromRGB(255, 175, 50), "BITE")
            return
        end
    end
    local _, curTotalFish = getFishCounts()
    if curTotalFish > lastKnownFishTotal and not isSellingFish then
        local delta = curTotalFish - lastKnownFishTotal
        lastKnownFishTotal = curTotalFish
        recordCatch("Inventory", delta)
    elseif curTotalFish < lastKnownFishTotal then
        lastKnownFishTotal = curTotalFish
    end

    if curTotalFish > FISH.catches then
        FISH.catches = curTotalFish
        if UI.updateHud then pcall(UI.updateHud) end
    end

    local a = anims()
    if (a.Success or (a.BringBack and (tappedThisCast or (lastCast > 0 and os.clock() - lastCast > 1.5)))) and castPhase == "casted" then
        if os.clock() - lastCatchTime > 1.0 then
            recordCatch(a.Success and "Success Animation" or "BringBack Animation", 1)
        end
        tappedThisCast = false
        castPhase = "idle"
        lastCast = 0
        if S.autoSell and FISH.catches > 0 and FISH.catches % math.max(1, S.sellEvery) == 0 then
            task.spawn(function()
                if sellAllFish() then
                    logAction("TRAVEL", "Returning to fishing spot...", Color3.fromRGB(90, 180, 255), "TRAVEL")
                    Status.state = "TRAVEL"
                    Status.color = Color3.fromRGB(90, 180, 255)
                    Status.action = "Returning to fishing spot..."
                    Status.detail = ("Returning to Spot #%d"):format(spotIndex)
                    if UI.updateBanner then pcall(UI.updateBanner) end
                    if UI.updateHud then pcall(UI.updateHud) end
                    if UI.updateBlackscreen then pcall(UI.updateBlackscreen) end
                    if S.legitFishing then
                        FISH.walkToSpotLegit(FISH_SPOTS[spotIndex], 300)
                    else
                        horseTeleport(FISH_SPOTS[spotIndex])
                        landBeside(FISH_SPOTS[spotIndex], 3)
                    end
                end
            end)
            return
        end
        task.wait(1.0)
        return
    end
    if a.ReelLoop then
        FISH.status = "reeling it in"
        logAction("FISH", "Reeling in the line...", Color3.fromRGB(255, 175, 50), "FISHING")
        return
    end
    if a.BringBack and not tappedThisCast and castPhase == "casted" and os.clock() - lastCast < 1.5 then
        castPhase = "idle"; lastCast = 0
        FISH.dead = FISH.dead + 1
        FISH.status = "cast failed (yanked back early)"
        logAction("FISH", "Cast yanked back early - resetting", Color3.fromRGB(245, 160, 60), "FISHING")
        task.wait(0.5)
        return
    end
    if not ensureRod() then return end

    -- Check auto-sell when out of money
    if S.autoSellOutOfMoney and moola() <= (S.lowMoneyThreshold or 10) then
        local _, fCount = getFishCounts()
        if fCount > 0 then
            task.spawn(function()
                if sellAllFish() then
                    logAction("TRAVEL", "Returning to fishing spot after selling...", Color3.fromRGB(90, 180, 255), "TRAVEL")
                    Status.state = "TRAVEL"
                    Status.color = Color3.fromRGB(90, 180, 255)
                    Status.action = "Returning to fishing spot..."
                    Status.detail = ("Returning to Spot #%d"):format(spotIndex)
                    if UI.updateBanner then pcall(UI.updateBanner) end
                    if UI.updateHud then pcall(UI.updateHud) end
                    if UI.updateBlackscreen then pcall(UI.updateBlackscreen) end
                    if S.legitFishing then
                        FISH.walkToSpotLegit(FISH_SPOTS[spotIndex], 300)
                    else
                        if horseTeleport(FISH_SPOTS[spotIndex]) then
                            landBeside(FISH_SPOTS[spotIndex], 3)
                            local l = spotLook(FISH_SPOTS[spotIndex])
                            local rr = root()
                            if l and rr then
                                pcall(function()
                                    rr.CFrame = CFrame.new(rr.Position, rr.Position + Vector3.new(l.X, 0, l.Z))
                                end)
                            end
                        end
                    end
                end
            end)
            return
        end
    end

    local bait = countTool("Bait")
    if bait < 1 and S.requireBait then
        if S.autoRestock and not isRestockingBait and not isSellingFish then
            task.spawn(function()
                local m = moola()
                local _, fCount = getFishCounts()
                if m < 10 and fCount > 0 then
                    logAction("RESTOCK", ("Low funds ($%d) for bait! Selling %d fish first..."):format(m, fCount), Color3.fromRGB(245, 175, 60), "SELLING")
                    if sellAllFish() then
                        if S.legitFishing then
                            FISH.walkToSpotLegit(FISH_SPOTS[spotIndex])
                        else
                            if horseTeleport(FISH_SPOTS[spotIndex]) then
                                landBeside(FISH_SPOTS[spotIndex], 3)
                                local l = spotLook(FISH_SPOTS[spotIndex])
                                local rr = root()
                                if l and rr then
                                    pcall(function()
                                        rr.CFrame = CFrame.new(rr.Position, rr.Position + Vector3.new(l.X, 0, l.Z))
                                    end)
                                end
                            end
                        end
                    end
                end
                if buyBait() then
                    logAction("TRAVEL", "Returning to fishing spot with fresh bait...", Color3.fromRGB(90, 180, 255), "TRAVEL")
                    if S.legitFishing then
                        FISH.walkToSpotLegit(FISH_SPOTS[spotIndex], 300)
                    else
                        if horseTeleport(FISH_SPOTS[spotIndex]) then
                            landBeside(FISH_SPOTS[spotIndex], 3)
                            local l = spotLook(FISH_SPOTS[spotIndex])
                            local rr = root()
                            if l and rr then
                                pcall(function()
                                    rr.CFrame = CFrame.new(rr.Position, rr.Position + Vector3.new(l.X, 0, l.Z))
                                end)
                            end
                        end
                    end
                else
                    logAction("RESTOCK", "Bait restock attempt deferred - will retry next cycle", Color3.fromRGB(245, 160, 60), "RESTOCK")
                end
            end)
        else
            FISH.status = "out of bait (waiting for restock)"
            logAction("FISH", "Out of bait - awaiting restock", Color3.fromRGB(245, 160, 60), "IDLE")
        end
        return
    end

    if castPhase == "casted" then
        if a.BringBack and os.clock() - lastCast < 4 then
            castPhase = "idle"; lastCast = 0
            FISH.dead = FISH.dead + 1
            FISH.status = "cast failed (yanked back)"
            logAction("FISH", "Cast yanked back early - resetting", Color3.fromRGB(245, 160, 60), "FISHING")
            return
        end
        if os.clock() - lastCast > S.castTimeout then
            castPhase = "idle"; lastCast = 0
            FISH.dead = FISH.dead + 1
            FISH.status = "no bite - recasting (" .. FISH.dead .. " dead)"
            logAction("FISH", ("No bite within %ds — recasting (%d dead)"):format(S.castTimeout, FISH.dead), Color3.fromRGB(245, 160, 60), "FISHING")
            if FISH.dead >= S.deadCastsBeforeMove then
                FISH.dead = 0
                spotIndex = (spotIndex % #FISH_SPOTS) + 1
                FISH.status = "rotating to spot " .. spotIndex
                logAction("FISH", ("Dead casts reached %d — rotating to spot #%d"):format(S.deadCastsBeforeMove, spotIndex), Color3.fromRGB(180, 140, 255), "TRAVEL")
                if S.legitFishing then
                    FISH.walkToSpotLegit(FISH_SPOTS[spotIndex])
                else
                    if horseTeleport(FISH_SPOTS[spotIndex]) then
                        landBeside(FISH_SPOTS[spotIndex], 3)
                        local l = spotLook(FISH_SPOTS[spotIndex])
                        local rr = root()
                        if l and rr then
                            pcall(function()
                                rr.CFrame = CFrame.new(rr.Position, rr.Position + Vector3.new(l.X, 0, l.Z))
                            end)
                        end
                    end
                end
            end
            return
        end
        local waitElapsed = math.floor(os.clock() - lastCast)
        FISH.status = ("waiting for bite %ds | casts %d catches %d"):format(waitElapsed, FISH.casts, FISH.catches)
        Status.state = "FISHING"
        Status.color = Color3.fromRGB(70, 200, 140)
        Status.action = ("Waiting for bite (%ds)"):format(waitElapsed)
        Status.detail = ("Cast #%d | Catches: %d | Bait: %d | Spot #%d"):format(FISH.casts, FISH.catches, bait, spotIndex)
        if UI.updateBanner then pcall(UI.updateBanner) end
        if UI.updateHud then pcall(UI.updateHud) end
        if UI.updateBlackscreen then pcall(UI.updateBlackscreen) end
        return
    end
    local r = root()
    local h = hum()
    if h and h:GetState() == Enum.HumanoidStateType.Swimming then
        FISH.status = "recovering from water"
        if S.legitFishing then
            FISH.walkToSpotLegit(FISH_SPOTS[spotIndex])
        else
            horseTeleport(FISH_SPOTS[spotIndex])
            landBeside(FISH_SPOTS[spotIndex], 3)
        end
        return
    end

    local hObj = myHorse()
    if isMounted(hObj) or (h and h.Sit) then
        FISH.status = "dismounting horse..."
        dismount()
        task.wait(0.3)
        return
    end

    local spot = FISH_SPOTS[spotIndex]
    local p = spotPos(spot)
    if not p then return end
    if r and (r.Position - p).Magnitude > 35 then
        if FISH.isWalking then
            -- Legit walk already actively navigating: do not spawn overlapping walk
            return
        end
        FISH.status = "travelling to fishing spot"
        logAction("TRAVEL", ("Travelling to fishing spot #%d (%.0f studs away)..."):format(spotIndex, (r.Position - p).Magnitude), Color3.fromRGB(90, 180, 255), "TRAVEL")
        if S.legitFishing then
            FISH.walkToSpotLegit(spot)
        else
            if horseTeleport(spot) then
                landBeside(spot, 3)
                local l = spotLook(spot)
                local rr = root()
                if l and rr then
                    pcall(function()
                        rr.CFrame = CFrame.new(rr.Position, rr.Position + Vector3.new(l.X, 0, l.Z))
                    end)
                end
            end
        end
        return
    end

    local camv = WS.CurrentCamera
    local camBefore = camv and camv.CFrame
    local r0 = root()
    local faceBefore = r0 and r0.CFrame
    local sLook = spotLook(spot)
    if not aimAtWater(sLook) then
        if camv and camBefore then camv.CFrame = camBefore end
        return
    end
    tap("PrimaryInput")
    task.delay(0.35, function()
        local c2 = WS.CurrentCamera
        if c2 and camBefore then pcall(function() c2.CFrame = camBefore end) end
        local rr = root()
        if rr and faceBefore then pcall(function() rr.CFrame = CFrame.new(rr.Position, rr.Position + faceBefore.LookVector) end) end
    end)
    lastCast = os.clock()
    castPhase = "casted"
    tappedThisCast = false
    startBiteWatch()
    FISH.casts = FISH.casts + 1
    local baitStr = bait > 0 and (" (bait " .. bait .. ")") or " (no bait)"
    FISH.status = "cast #" .. FISH.casts .. baitStr
    logAction("FISH", ("Cast #%d launched towards water%s"):format(FISH.casts, baitStr), Color3.fromRGB(80, 220, 140), "FISHING",
        ("Spot #%d | Catches: %d"):format(spotIndex, FISH.catches))
end

local function startFishing()
    S.autoFish = true
    FISH.casts, FISH.dead = 0, 0
    castPhase, lastCast = "idle", 0
    FISH.status = "starting"
    logAction("FISH", "Starting Auto-Fish routine...", Color3.fromRGB(80, 220, 140), "FISHING")
    loop("autoFish", 0.25, fishTick)
end
getgenv().BW3_BuyBait = function() return buyBait() end
getgenv().BW3_SellFish = function() return sellAllFish() end
getgenv().BW3_StartFish = function() startFishing() end
local function stopFishing()
    S.autoFish = false
    loops["autoFish"] = false
    castPhase, lastCast = "idle", 0
    FISH.status = "stopped"
    logAction("FISH", "Stopped Auto-Fish", Color3.fromRGB(160, 165, 180), "IDLE")
end
getgenv().BW3_StopFish = function() stopFishing() end


return {
    FISH = FISH,
    FISH_SPOTS = FISH_SPOTS,
    spotIndex = spotIndex,
    VENDOR = VENDOR,
    startFishing = startFishing,
    stopFishing = stopFishing,
    fishTick = fishTick,
    aimAtWater = aimAtWater,
    handleQTE = handleQTE,
    ensureRod = ensureRod,
    startBiteWatch = startBiteWatch,
}
end

-- [[[ MODULE: Automation ]]]
EMBEDDED_MODULES["Automation"] = function(...)
-- ============================================================
-- BRIDGER HUB (BW) - MODULE: Automation
-- Pickups sweep, Ore/Crop auto-farming, Auto-buy bait & sell
-- ============================================================
local ctx = ...


-- ── pickups / shop / farm ──────────────────────────────────────────────────
local function promptSweep(folder, range, skipHeld)
    if not firepp then return end
    local r = root()
    local f = WS:FindFirstChild(folder)
    if not r or not f then return end
    local held
    if skipHeld then
        held = {}
        for _, src in ipairs({ LP:FindFirstChild("Backpack"), char() }) do
            if src then for _, t in ipairs(src:GetChildren()) do if t:IsA("Tool") then held[t.Name] = true end end end
        end
    end
    for _, item in ipairs(f:GetChildren()) do
        if not (held and held[item.Name]) then
            local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
            if part and (part.Position - r.Position).Magnitude <= range then
                for _, d in ipairs(item:GetDescendants()) do
                    if d:IsA("ProximityPrompt") and d.Enabled then pcall(firepp, d, d.HoldDuration or 0) end
                end
            end
        end
    end
end

local FARM = { status = "idle", busy = false, opened = 0 }
local SPAWNED_AT, DONE_UNTIL = {}, {}

for _, fname in ipairs({ "Chests", "SpawnedHerbs" }) do
    local f = WS:FindFirstChild(fname)
    if f then
        for _, item in ipairs(f:GetChildren()) do SPAWNED_AT[item] = 0 end
        conns[#conns + 1] = f.ChildAdded:Connect(function(item)
            SPAWNED_AT[item] = os.clock()
        end)
        conns[#conns + 1] = f.ChildRemoved:Connect(function(item)
            SPAWNED_AT[item] = nil
            DONE_UNTIL[item] = nil
        end)
    end
end

local function nearestPrompted(folderName, skipHeld)
    local r = root()
    local f = WS:FindFirstChild(folderName)
    if not r or not f then return nil end
    local held
    if skipHeld then
        held = {}
        for _, src in ipairs({ LP:FindFirstChild("Backpack"), char() }) do
            if src then for _, t in ipairs(src:GetChildren()) do if t:IsA("Tool") then held[t.Name] = true end end end
        end
    end
    local best, bestD, bestPrompt, bestScore, bestItem
    local now = os.clock()
    for _, item in ipairs(f:GetChildren()) do
        local onCooldown = DONE_UNTIL[item] and now < DONE_UNTIL[item]
        if not (held and held[item.Name]) and not onCooldown then
            local prompt
            for _, d in ipairs(item:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled then prompt = d; break end
            end
            if prompt then
                local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local dist = (part.Position - r.Position).Magnitude
                    local age = SPAWNED_AT[item] and (now - SPAWNED_AT[item]) or math.huge
                    local score = dist
                    if age < 90 then score = dist * 0.25 end
                    if not bestScore or score < bestScore then
                        best, bestD, bestPrompt, bestScore, bestItem = part, dist, prompt, score, item
                    end
                end
            end
        end
    end
    return best, bestD, bestPrompt, bestItem
end

local function sitBeside(pos, seconds)
    local h = hum()
    local oldSit = h and h.Sit
    if h then
        pcall(function()
            h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            h:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
            h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            h.Sit = true
        end)
    end
    task.wait(0.12)
    local t0 = os.clock()
    while os.clock() - t0 < (seconds or 1.2) do
        local rr = root()
        if rr then
            rr.CFrame = CFrame.new(pos)
            rr.AssemblyLinearVelocity = Vector3.zero
        end
        RunService.Heartbeat:Wait()
    end
    local h2 = hum()
    if h2 then
        pcall(function()
            h2.Sit = oldSit or false
            h2:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            h2:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            h2:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end)
    end
end

local function farmTick(folderName, label, skipHeld)
    if FARM.busy then return end
    local part, dist, prompt, item = nearestPrompted(folderName, skipHeld)
    if not part then
        FARM.status = label .. ": none available"
        return
    end
    if dist <= S.promptRange then
        FARM.status = ("%s: opening (%d studs)"):format(label, math.floor(dist))
        logAction("FARM", ("Interacting with %s (%d studs)..."):format(label, math.floor(dist)), Color3.fromRGB(180, 140, 255), "FARMING")
        promptSweep(folderName, S.promptRange, skipHeld)
        if item then DONE_UNTIL[item] = os.clock() + 45 end
        FARM.opened = FARM.opened + 1
        logAction("FARM", ("Opened %s! (Total: %d)"):format(label, FARM.opened), Color3.fromRGB(60, 240, 140), "SUCCESS")
        return
    end
    FARM.busy = true
    FARM.status = ("%s: %d studs away - travelling"):format(label, math.floor(dist))
    logAction("FARM", ("Travelling to %s (%d studs away)..."):format(label, math.floor(dist)), Color3.fromRGB(180, 140, 255), "FARMING")
    task.spawn(function()
        pcall(function()
            local dest = part.Position
            if dist > 70 then
                horseTeleport(dest)
                landBeside(dest, 4)
            end
            local approach = dest + Vector3.new(0, 3, 0)
            sitBeside(approach, 0.8)
            FARM.status = label .. ": opening"
            for _ = 1, 6 do
                if firepp and prompt and prompt.Parent and prompt.Enabled then
                    pcall(firepp, prompt, prompt.HoldDuration or 0)
                end
                promptSweep(folderName, S.promptRange, skipHeld)
                task.wait(0.25)
            end
            if item then DONE_UNTIL[item] = os.clock() + 45 end
            FARM.opened = FARM.opened + 1
            logAction("FARM", ("Opened %s! (Total: %d)"):format(label, FARM.opened), Color3.fromRGB(60, 240, 140), "SUCCESS")
        end)
        task.wait(0.4)
        FARM.busy = false
    end)
end

getgenv().BW3_FarmTick = function(a, b, c) return farmTick(a, b, c) end

-- (Kaitun mode stripped: dedicated kaitun.luau should be used instead)


local function padCatalog()
    local names, seen = {}, {}
    local f = WS:FindFirstChild("PurchasePads")
    if not f then return names end
    for _, v in ipairs(f:GetChildren()) do
        local tn = v:GetAttribute("ToolName")
        if tn and not seen[tn] then seen[tn] = true; names[#names + 1] = tn end
    end
    table.sort(names)
    return names
end

local _buyStatus = "off"
local function autoBuyTick()
    if not fireclick then _buyStatus = "no fireclickdetector"; return end
    local r, f = root(), WS:FindFirstChild("PurchasePads")
    if not r or not f then return end
    local m = moola()
    local pad, bd
    for _, v in ipairs(f:GetChildren()) do
        if v:IsA("BasePart") and v:GetAttribute("ToolName") == S.buyTarget then
            local d = (v.Position - r.Position).Magnitude
            if not bd or d < bd then pad, bd = v, d end
        end
    end
    if not pad then _buyStatus = "no pad sells " .. S.buyTarget; return end
    local price = pad:GetAttribute("Price") or 0
    local maxOwn = pad:GetAttribute("MaxOwn")
    if maxOwn and countTool(S.buyTarget) >= maxOwn then _buyStatus = S.buyTarget .. " at max"; return end
    if m - price < S.buyReserve then
        _buyStatus = ("hold: %s=%d have %d keep %d"):format(S.buyTarget, price, m, S.buyReserve); return
    end
    if bd > 20 then _buyStatus = ("pad %d studs away"):format(math.floor(bd)); return end
    local cd = pad:FindFirstChildOfClass("ClickDetector")
    if not cd then _buyStatus = "pad has no ClickDetector"; return end
    pcall(fireclick, cd)
    _buyStatus = ("bought %s (%d)"):format(S.buyTarget, price)
    logAction("SHOP", ("Purchased %s ($%d) from pad"):format(S.buyTarget, price), Color3.fromRGB(60, 240, 140), "SUCCESS")
end


return {
    FARM = FARM,
    promptSweep = promptSweep,
    nearestPrompted = nearestPrompted,
    sitBeside = sitBeside,
    farmTick = farmTick,
    padCatalog = padCatalog,
    autoBuyTick = autoBuyTick,
}
end

-- [[[ MODULE: Visuals ]]]
EMBEDDED_MODULES["Visuals"] = function(...)
-- ============================================================
-- BRIDGER HUB (BW) - MODULE: Visuals
-- 2D/3D ESP, Tracers, Boxes, Player Highlights & Drawing pool
-- ============================================================
local ctx = ...


-- ── ESP ────────────────────────────────────────────────────────────────────
local function getDraw(i)
    local d = draws[i]
    if d then return d end
    local ok, o = pcall(function() return Drawing.new("Text") end)
    if not ok or not o then return nil end
    o.Size = 14; o.Center = true; o.Outline = true; o.Font = 2; o.Visible = false
    draws[i] = o
    return o
end
local function hideDraws(from) for i = from, #draws do if draws[i] then pcall(function() draws[i].Visible = false end) end end end
local function clearDraws()
    for i = 1, #draws do
        if draws[i] then pcall(function() draws[i]:Remove() end) end
        draws[i] = nil
    end
end

local espOn = false
local function espTick()
    local camv, r = WS.CurrentCamera, root()
    if not camv or not r then hideDraws(1); return end
    local idx = 0
    local function put(pos, txt, col)
        local sp, on = camv:WorldToViewportPoint(pos)
        if not on then return end
        idx = idx + 1
        local d = getDraw(idx)
        if not d then return end
        d.Text = txt; d.Color = col; d.Position = Vector2.new(sp.X, sp.Y); d.Visible = true
    end
    local function folder(name, col, tag)
        local f = WS:FindFirstChild(name)
        if not f then return end
        for _, v in ipairs(f:GetChildren()) do
            local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local d = (part.Position - r.Position).Magnitude
                if d <= S.espRange then put(part.Position, tag .. " " .. math.floor(d), col) end
            end
        end
    end
    if S.espHerb then folder("SpawnedHerbs", Color3.fromRGB(120, 255, 140), "HERB") end
    if S.espChest then folder("Chests", Color3.fromRGB(255, 200, 80), "CHEST") end
    if S.espHorse then
        local f = WS:FindFirstChild("Entities")
        if f then
            for _, e in ipairs(f:GetChildren()) do
                local p = e:FindFirstChildWhichIsA("ProximityPrompt", true)
                if p and p.ActionText == "Mount" then
                    local part = e:FindFirstChild("HumanoidRootPart")
                    if part then
                        local d = (part.Position - r.Position).Magnitude
                        local o = e:FindFirstChild("Owner")
                        local mine = o and o.Value == LP
                        if d <= S.espRange then
                            put(part.Position, (mine and "MY HORSE " or "HORSE ") .. math.floor(d),
                                mine and Color3.fromRGB(120, 255, 180) or Color3.fromRGB(210, 170, 120))
                        end
                    end
                end
            end
        end
    end
    if S.espPlayers then
        for _, o in ipairs(Players:GetPlayers()) do
            if o ~= LP and o.Character then
                local hh = o.Character:FindFirstChildOfClass("Humanoid")
                local hd = o.Character:FindFirstChild("Head")
                if hh and hd and hh.Health > 0 then
                    local d = (hd.Position - r.Position).Magnitude
                    if d <= S.espRange then
                        local isF = isPlayerFriend(o)
                        local oStand, oTier, oAlign = getStandInfo(o)
                        local standTag = oStand ~= "None" and (" | " .. oStand .. " [" .. oAlign .. "]") or ""
                        local nameTag = isF and ("[FRIEND] " .. o.Name) or o.Name
                        local espCol = isF and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(140, 190, 255)
                        put(hd.Position + Vector3.new(0, 2.5, 0),
                            ("%s (%d HP) [%dm]%s"):format(nameTag, math.floor(hh.Health), math.floor(d), standTag),
                            espCol)
                    end
                end
            end
        end
    end
    hideDraws(idx + 1)
end
local function ensureESP()
    local want = S.espChest or S.espHerb or S.espHorse or S.espPlayers or S.chamsWhite
    if want and not espOn then
        espOn = true
        task.spawn(function()
            while S.running and (S.espChest or S.espHerb or S.espHorse or S.espPlayers or S.chamsWhite) do
                pcall(espTick)
                if COMBAT and COMBAT.updateChams then
                    pcall(COMBAT.updateChams)
                end
                RunService.RenderStepped:Wait()
            end
            espOn = false
            pcall(hideDraws, 1)
            if COMBAT and COMBAT.updateChams then
                pcall(COMBAT.updateChams)
            end
        end)
    end
end


return {
    getDraw = getDraw,
    hideDraws = hideDraws,
    clearDraws = clearDraws,
    espTick = espTick,
    ensureESP = ensureESP,
}
end

-- [[[ MODULE: Saint ]]]
EMBEDDED_MODULES["Saint"] = function(...)
-- ============================================================
-- BRIDGER HUB (BW) - MODULE: Saint
-- Saint's Corpse radar, Auto-pickup & Safe retreat loop
-- ============================================================
local ctx = ...


-- ── Saint's Corpse ─────────────────────────────────────────────────────────
local SAINT: any = { status = "idle", detects = 0, grabs = 0, lastPart = "none", retreating = false, busy = false, wasHoldingPart = false }

function SAINT.defendCorpse()
    local gunName = S.saintGunSelect
    if not gunName or gunName == "None" then return end
    local gun = findTool(gunName)
    if not gun then return end
    equipTool(gunName)

    local myR = root()
    if not myR then return end
    local bestDist = 2500
    local bestChar, bestPart = nil, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not isPlayerFriend(p) then
            local tc = p.Character
            if tc and tc.Parent and not COMBAT.isTargetDown(tc) then
                local head = tc:FindFirstChild("Head") or tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("HumanoidRootPart")
                if head then
                    local d = (head.Position - myR.Position).Magnitude
                    if d < bestDist then
                        local clear = COMBAT.hasLineOfSight(myR.Position, head.Position, tc)
                        if clear then
                            bestDist = d
                            bestChar = tc
                            bestPart = head
                        end
                    end
                end
            end
        end
    end

    if not bestChar or not bestPart then return end

    COMBAT.ensureHook()

    local ammoVal = gun:FindFirstChild("AmmoInClip")
    local ammo = ammoVal and ammoVal.Value or 6
    local isReloading = char() and char():GetAttribute("IsReloading") == true

    if isReloading then return end

    if ammo > 0 then
        myR.CFrame = CFrame.new(myR.Position, Vector3.new(bestPart.Position.X, myR.Position.Y, bestPart.Position.Z))
        local isSniper = gun.Name:lower():find("martini") or (gun:FindFirstChild("ClientConfig") and require(gun.ClientConfig).RequiresAimToFire)
        if isSniper then
            if IH then
                IH:FireVirtualInput("SecondaryInput", true)
                task.wait(0.1)
                IH:FireVirtualInput("PrimaryInput", true)
                task.wait(0.04)
                IH:FireVirtualInput("PrimaryInput", false)
                task.wait(0.06)
                IH:FireVirtualInput("SecondaryInput", false)
            else
                tap("SecondaryInput", 0.1)
                tap("PrimaryInput", 0.04)
            end
        else
            if IH then
                IH:FireVirtualInput("PrimaryInput", true)
                task.wait(0.04)
                IH:FireVirtualInput("PrimaryInput", false)
            else
                tap("PrimaryInput", 0.04)
            end
        end
        local delay = 0.25
        pcall(function()
            local cfg = require(gun:FindFirstChild("ServerConfig"))
            if cfg and cfg.FireRate then delay = cfg.FireRate + 0.05 end
        end)
        task.wait(delay)
    else
        if IH then
            IH:FireVirtualInput("ActionInput2", true)
            task.wait(0.05)
            IH:FireVirtualInput("ActionInput2", false)
        else
            tap("ActionInput2", 0.05)
        end
        task.wait(0.3)
    end
end

local function holdingCorpse()
    local c = char()
    if c and c:GetAttribute("HasCorpsePart") == true then return true end
    for _, src in ipairs({ LP:FindFirstChild("Backpack"), c }) do
        if src then
            for _, t in ipairs(src:GetChildren()) do
                if t:IsA("Tool") and tostring(t.Name):lower():find("saint", 1, true) then return true end
            end
        end
    end
    return false
end

local SEEN_AT = {}
local function announcementLive()
    local g = LP:FindFirstChildOfClass("PlayerGui")
    if not g then return false end
    for _, d in ipairs(g:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
            local tx = tostring(d.Text):lower()
            if tx:find("it appears", 1, true) then return true end
        end
    end
    return false
end

local function corpseCandidates()
    local live, parked = {}, 0
    local now = os.clock()
    local function consider(part, wrapped)
        if not part:IsA("BasePart") then return end
        if tostring(part.Name):sub(1, 6) ~= "Saints" then return end
        if SEEN_AT[part] == nil then SEEN_AT[part] = now end
        local prompt
        for _, x in ipairs(part:GetDescendants()) do
            if x:IsA("ProximityPrompt") then prompt = x; break end
        end
        if not prompt or not prompt.Enabled then parked = parked + 1; return end
        if part:GetAttribute("BeingPickedUp") == true then parked = parked + 1; return end
        if not wrapped and part.Position.Y < 15 then parked = parked + 1; return end
        local announcedAt = SAINT.announcedAt or -math.huge
        if SEEN_AT[part] < announcedAt - 5 then parked = parked + 1; return end
        live[#live + 1] = { part = part, prompt = prompt, wrapped = wrapped }
    end
    for _, d in ipairs(WS:GetChildren()) do
        if d:IsA("BasePart") then
            consider(d, false)
        elseif d:IsA("Model") and tostring(d.Name):lower():find("_corpse", 1, true) then
            for _, c in ipairs(d:GetChildren()) do consider(c, true) end
        end
    end
    return live, parked
end

local function holdE(seconds)
    local vk = 0x45
    if keypressFn and keyreleaseFn then
        pcall(keypressFn, vk)
        local t0 = os.clock()
        while os.clock() - t0 < seconds do
            if holdingCorpse() then break end
            task.wait(0.05)
        end
        pcall(keyreleaseFn, vk)
        return true
    end
    return false
end

local function retreatSafe()
    if SAINT.retreating then return end
    SAINT.retreating = true
    SAINT.status = "RETREATING with the part"
    logAction("SAINT", "Secured corpse part! Retreating to safe location...", Color3.fromRGB(90, 180, 255), "TRAVEL")
    task.spawn(function()
        pcall(function()
            local dest = PC.saintRetreat
            if not dest then
                local best, bestScore
                local f = WS:FindFirstChild("NPC")
                if f then
                    for _, npc in ipairs(f:GetChildren()) do
                        local p = npc:FindFirstChild("HumanoidRootPart")
                            or npc:FindFirstChildWhichIsA("BasePart", true)
                        if p then
                            local nearest = math.huge
                            for _, o in ipairs(Players:GetPlayers()) do
                                if o ~= LP and o.Character then
                                    local orp = o.Character:FindFirstChild("HumanoidRootPart")
                                    if orp then
                                        local dd = (orp.Position - p.Position).Magnitude
                                        if dd < nearest then nearest = dd end
                                    end
                                end
                            end
                            if not bestScore or nearest > bestScore then best, bestScore = p.Position, nearest end
                        end
                    end
                end
                dest = best
            end
            if dest then
                horseTeleport(dest)
                landBeside(dest, 6)
                SAINT.status = "hidden - stay alive until it merges"
                logAction("SAINT", "Safely hidden at retreat point. Awaiting stand merge.", Color3.fromRGB(80, 220, 140), "SAINT")
            else
                SAINT.status = "no retreat point found"
                logAction("SAINT", "No safe retreat point found", Color3.fromRGB(245, 90, 90), "ERROR")
            end
        end)
        task.wait(2)
        SAINT.retreating = false
    end)
end

local function grabCorpse(entry)
    if SAINT.busy then return end
    SAINT.busy = true
    SAINT.grabs = SAINT.grabs + 1
    SAINT.lastPart = entry.part.Name
    task.spawn(function()
        pcall(function()
            local part, prompt = entry.part, entry.prompt
            local r = root()
            local dist = r and (part.Position - r.Position).Magnitude or 9999
            SAINT.status = ("going for %s (%d studs)"):format(part.Name, math.floor(dist))
            logAction("SAINT", ("Going for corpse: %s (%d studs away)..."):format(part.Name, math.floor(dist)), Color3.fromRGB(255, 110, 110), "SAINT")
            if dist > 70 then
                horseTeleport(part.Position)
                landBeside(part.Position, 5)
            end
            if not part.Parent then
                SAINT.status = "part vanished"
                logAction("SAINT", "Corpse part disappeared before arrival", Color3.fromRGB(245, 90, 90), "ERROR")
                return
            end
            local preWait = math.clamp(tonumber(S.saintPreHoldWait) or 0, 0, 120)
            if preWait > 0 then
                local tWaitStart = os.clock()
                logAction("SAINT", string.format("Arrived at corpse (%s). Waiting %ds before grabbing...", part.Name, preWait), Color3.fromRGB(255, 180, 80), "SAINT")
                while os.clock() - tWaitStart < preWait and S.running and part.Parent do
                    local rem = math.ceil(preWait - (os.clock() - tWaitStart))
                    SAINT.status = string.format("waiting %ds to grab %s", rem, part.Name)
                    local rr = root()
                    if rr and (rr.Position - part.Position).Magnitude > 20 then
                        rr.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                        rr.AssemblyLinearVelocity = Vector3.zero
                    end
                    if S.saintDefendGun and S.saintGunSelect and S.saintGunSelect ~= "None" then
                        pcall(SAINT.defendCorpse)
                    end
                    task.wait(0.1)
                end
                if not part.Parent then
                    SAINT.status = "part vanished during wait"
                    logAction("SAINT", "Corpse part disappeared during pre-grab wait", Color3.fromRGB(245, 90, 90), "ERROR")
                    return
                end
            end
            local hold = math.max((prompt.HoldDuration or 3) + 2, 5)
            local stop = false
            task.spawn(function()
                local t0 = os.clock()
                while os.clock() - t0 < hold + 2 and not stop do
                    local rr = root()
                    if rr and part.Parent then
                        rr.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                        rr.AssemblyLinearVelocity = Vector3.zero
                    end
                    RunService.Heartbeat:Wait()
                end
            end)
            task.wait(0.4)
            local h0 = hum()
            SAINT.status = "holding E on " .. part.Name
            logAction("SAINT", ("Holding interaction [E] on %s..."):format(part.Name), Color3.fromRGB(255, 130, 90), "SAINT")
            if h0 then pcall(function() h0.Sit = false end) end
            holdE(hold)
            if not holdingCorpse() then
                SAINT.status = "E hold failed, trying fireproximityprompt"
                logAction("SAINT", "Key hold failed, attempting direct prompt fire...", Color3.fromRGB(245, 160, 60), "SAINT")
                if firepp and prompt and prompt.Parent then
                    for _ = 1, 3 do
                        pcall(firepp, prompt, prompt.HoldDuration or 0)
                        task.wait(0.4)
                        if holdingCorpse() then break end
                    end
                end
            end
            stop = true
            task.wait(0.3)
            if holdingCorpse() then
                SAINT.status = "GOT IT - retreating"
                logAction("SAINT", ("Secured corpse part: %s!"):format(part.Name), Color3.fromRGB(60, 240, 140), "SUCCESS")
                if S.saintRetreat then retreatSafe() end
            else
                SAINT.status = "grab failed on " .. part.Name
                logAction("SAINT", ("Failed to secure corpse part: %s"):format(part.Name), Color3.fromRGB(245, 90, 90), "ERROR")
            end
        end)
        task.wait(1)
        SAINT.busy = false
    end)
end

local function saintTick()
    if not S.saintWatch then return end
    local isHolding = holdingCorpse()
    if SAINT.wasHoldingPart and not isHolding then
        local h = hum()
        if h and h.Health > 0 then
            SAINT.status = "stand merged!"
            logAction("SAINT", "Stand merge completed successfully!", Color3.fromRGB(60, 240, 140), "SUCCESS")
            if S.saintMergeTpPlayer and S.saintMergeTpPlayer ~= "None" then
                local targetPlr = Players:FindFirstChild(S.saintMergeTpPlayer)
                local tc = targetPlr and targetPlr.Character
                local tr = tc and (tc:FindFirstChild("HumanoidRootPart") or tc.PrimaryPart or tc:FindFirstChild("Torso"))
                if tr then
                    logAction("SAINT", ("Auto-teleporting to %s after merge..."):format(targetPlr.Name), Color3.fromRGB(80, 255, 140), "TRAVEL")
                    horseTeleport(tr.Position)
                    landBeside(tr.Position, 3)
                else
                    logAction("SAINT", ("Merge complete, but target player %s has no character"):format(S.saintMergeTpPlayer), Color3.fromRGB(245, 160, 60), "SAINT")
                end
            end
        end
    end
    SAINT.wasHoldingPart = isHolding

    if isHolding then
        if S.saintRetreat and not SAINT.retreating then
            SAINT.status = "holding a part"
            retreatSafe()
        end
        return
    end
    if SAINT.busy then return end
    if announcementLive() then
        if not SAINT.announcedAt or os.clock() - SAINT.announcedAt > 30 then
            SAINT.announcedAt = os.clock()
            logAction("SAINT", "Announcement detected: 'IT APPEARS ONCE AGAIN'", Color3.fromRGB(255, 110, 110), "SAINT")
        end
        SAINT.lastAnnounce = os.clock()
    end
    if not SAINT.announcedAt or os.clock() - SAINT.announcedAt > (S.saintWindow or 300) then
        SAINT.status = "waiting for \"IT APPEARS ONCE AGAIN\""
        return
    end
    local live, parked = corpseCandidates()
    if #live == 0 then
        SAINT.status = parked > 0
            and ("waiting - %d part(s) claimed or underground"):format(parked)
            or "waiting for a spawn"
        return
    end
    SAINT.detects = SAINT.detects + 1
    local r = root()
    table.sort(live, function(a, b)
        if not r then return false end
        return (a.part.Position - r.Position).Magnitude < (b.part.Position - r.Position).Magnitude
    end)
    if S.saintGrab then
        grabCorpse(live[1])
    else
        SAINT.status = ("%s available (%d studs)"):format(live[1].part.Name,
            r and math.floor((live[1].part.Position - r.Position).Magnitude) or -1)
    end
end

getgenv().BW3_SaintTick = function() return saintTick() end
getgenv().BW3_SaintRetreat = function() return retreatSafe() end


return {
    SAINT = SAINT,
    holdingCorpse = holdingCorpse,
    announcementLive = announcementLive,
    grabCorpse = grabCorpse,
    retreatSafe = retreatSafe,
    saintTick = saintTick,
}
end

-- [[[ MODULE: UI ]]]
EMBEDDED_MODULES["UI"] = function(...)
-- ============================================================
-- BRIDGER HUB (BW) - MODULE: UI
-- Design system, Component builders, Mini-HUD & Main Window
-- ============================================================
local ctx = ...
local SHARED = getfenv()
local UI = SHARED.UI or { tabs = {} }
SHARED.UI = UI


-- ── UI DESIGN SYSTEM & BUILDERS ────────────────────────────────────────────
local TH = {
    bg = Color3.fromRGB(15, 17, 23),
    header = Color3.fromRGB(19, 22, 30),
    card = Color3.fromRGB(22, 25, 34),
    cardHover = Color3.fromRGB(28, 32, 44),
    border = Color3.fromRGB(36, 41, 56),
    accent = Color3.fromRGB(230, 165, 55),
    accentHover = Color3.fromRGB(245, 180, 70),
    text = Color3.fromRGB(242, 244, 250),
    dim = Color3.fromRGB(140, 146, 165),
    darkText = Color3.fromRGB(15, 17, 23),

    green = Color3.fromRGB(68, 207, 138),
    amber = Color3.fromRGB(245, 170, 50),
    red = Color3.fromRGB(245, 90, 90),
    blue = Color3.fromRGB(80, 170, 255),
    purple = Color3.fromRGB(175, 130, 255),
}

local function mk(cls, props, parent)
    local i = Instance.new(cls)
    for k, v in pairs(props) do i[k] = v end
    if parent then i.Parent = parent end
    return i
end
local function corner(p, r) mk("UICorner", { CornerRadius = UDim.new(0, r or 8) }, p) end
local function stroke(p, c, thickness)
    return mk("UIStroke", { Color = c or TH.border, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
end
local function parentGui(sg)
    pcall(function() sg.Parent = gethui and gethui() end)
    if not sg.Parent then pcall(function() sg.Parent = game:GetService("CoreGui") end) end
    if not sg.Parent then sg.Parent = LP:WaitForChild("PlayerGui") end
end

local function card(tab, title)
    local c = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = TH.card,
    }, tab.page)
    corner(c, 8)
    stroke(c, TH.border)

    mk("UIPadding", {
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
    }, c)

    mk("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, c)

    if title then
        mk("TextLabel", {
            Size = UDim2.new(1, 0, 0, 18),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            Text = title:upper(),
            TextColor3 = TH.accent,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 0,
        }, c)
    end
    return c
end

local togglesByKey = {}
local function updateAllTogglesUI()
    for key, fns in pairs(togglesByKey) do
        local val = S[key]
        for _, fn in ipairs(fns) do
            pcall(fn, val)
        end
    end
end
UI.updateAllTogglesUI = updateAllTogglesUI

function UI.setToggle(key, val)
    S[key] = val
    if togglesByKey[key] then
        for _, fn in ipairs(togglesByKey[key]) do
            pcall(fn, val)
        end
    end
end

local function toggle(parentCard, name, desc, key, onChange)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, desc and 40 or 32),
        BackgroundColor3 = TH.header,
    }, parentCard)
    corner(row, 6)
    stroke(row, TH.border)

    local textY = desc and 3 or 0
    mk("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, textY),
        Size = UDim2.new(1, -65, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = name,
        TextColor3 = TH.text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    if desc then
        mk("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(10, 20),
            Size = UDim2.new(1, -65, 0, 14),
            Font = Enum.Font.Gotham,
            Text = desc,
            TextColor3 = TH.dim,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, row)
    end

    local pill = mk("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(36, 18),
        BackgroundColor3 = S[key] and TH.accent or Color3.fromRGB(48, 52, 66),
    }, row)
    corner(pill, 9)

    local knob = mk("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = S[key] and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = S[key] and TH.darkText or TH.text,
    }, pill)
    corner(knob, 7)

    local function setVisual(val)
        TS:Create(pill, TweenInfo.new(0.14), {
            BackgroundColor3 = val and TH.accent or Color3.fromRGB(48, 52, 66)
        }):Play()
        TS:Create(knob, TweenInfo.new(0.14), {
            Position = val and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            BackgroundColor3 = val and TH.darkText or TH.text,
        }):Play()
    end
    togglesByKey[key] = togglesByKey[key] or {}
    table.insert(togglesByKey[key], setVisual)

    local b = mk("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, row)
    track(b.MouseButton1Click:Connect(function()
        S[key] = not S[key]
        setVisual(S[key])
        if onChange then task.spawn(onChange, S[key]) end
    end))
end

local function slider(parentCard, name, key, min, max, step, suffix)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = TH.header,
    }, parentCard)
    corner(row, 6)
    stroke(row, TH.border)

    mk("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 4),
        Size = UDim2.new(0.65, 0, 0, 18),
        Font = Enum.Font.GothamMedium,
        Text = name,
        TextColor3 = TH.text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local valPill = mk("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 4),
        Size = UDim2.fromOffset(50, 16),
        BackgroundColor3 = TH.card,
    }, row)
    corner(valPill, 4)
    stroke(valPill, TH.border)

    local valLabel = mk("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamBold,
        Text = tostring(S[key]),
        TextColor3 = TH.accent,
        TextSize = 10,
    }, valPill)

    local bar = mk("Frame", {
        Position = UDim2.fromOffset(10, 28),
        Size = UDim2.new(1, -20, 0, 6),
        BackgroundColor3 = Color3.fromRGB(40, 45, 58),
    }, row)
    corner(bar, 3)

    local fill = mk("Frame", {
        Size = UDim2.fromScale(math.clamp((S[key] - min) / (max - min), 0, 1), 1),
        BackgroundColor3 = TH.accent,
    }, bar)
    corner(fill, 3)

    local function render()
        local pct = math.clamp((S[key] - min) / (max - min), 0, 1)
        fill.Size = UDim2.fromScale(pct, 1)
        valLabel.Text = tostring(S[key]) .. (suffix and (" " .. suffix) or "")
    end
    render()

    local dragging = false
    local function set(i)
        local a = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        S[key] = math.floor((min + (max - min) * a) / step + 0.5) * step
        render()
    end
    track(bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; set(i)
        end
    end))
    track(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then set(i) end
    end))
    track(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
end

